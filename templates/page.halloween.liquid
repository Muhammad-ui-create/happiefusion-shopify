  <script>
  /* Swap the hero before first paint so the visitor sees the ad they clicked. */
  (function () {
    var HERO = {
      cauldron: { h: 'Fill the <em>cauldron.</em>', s: 'Stock up for Halloween night.', pack: '24', pos: 'tc', dpos: 'tr',
        alt: 'Cans of Happie Fungi Fusion on ice in a cauldron on a Halloween porch',
        w: ['{{ 'halloween-cauldron-16x9.jpg' | asset_img_url: '1280x' }}', '{{ 'halloween-cauldron-16x9.jpg' | asset_img_url: '1920x' }}'],
        m: ['{{ 'halloween-cauldron-4x5.jpg' | asset_img_url: '720x' }}', '{{ 'halloween-cauldron-4x5.jpg' | asset_img_url: '1080x' }}'] },
      boo: { h: '<em>Boo.</em><br>No booze.', s: 'Halloween’s alcohol-free pour.', pack: '18', pos: 'tl',
        alt: 'A hand holding a can of Happie Fungi Fusion Blue Raspberry at a Halloween party',
        w: ['{{ 'halloween-boo-16x9.jpg' | asset_img_url: '1280x' }}', '{{ 'halloween-boo-16x9.jpg' | asset_img_url: '1920x' }}'],
        m: ['{{ 'halloween-boo-4x5.jpg' | asset_img_url: '720x' }}', '{{ 'halloween-boo-4x5.jpg' | asset_img_url: '1080x' }}'] },
      treat: { h: 'All treat. <em>No trick.</em>', s: 'Alcohol-free. Caffeine-free. 35 calories.', pack: '18', pos: 'bc',
        alt: 'A can of Happie Fungi Fusion Mango Mimosa surrounded by Halloween candy',
        w: ['{{ 'halloween-treat-16x9.jpg' | asset_img_url: '1280x' }}', '{{ 'halloween-treat-16x9.jpg' | asset_img_url: '1920x' }}'],
        m: ['{{ 'halloween-treat-4x5.jpg' | asset_img_url: '720x' }}', '{{ 'halloween-treat-4x5.jpg' | asset_img_url: '1080x' }}'] },
      brew: { h: 'The only <em>brew</em><br>you need.', s: 'Three mushrooms. Zero alcohol.', pack: '18', pos: 'tl',
        alt: 'A can of Happie Fungi Fusion Watermelon beside a smoking cauldron, candles and pumpkins',
        w: ['{{ 'halloween-brew-16x9.jpg' | asset_img_url: '1280x' }}', '{{ 'halloween-brew-16x9.jpg' | asset_img_url: '1920x' }}'],
        m: ['{{ 'halloween-brew-4x5.jpg' | asset_img_url: '720x' }}', '{{ 'halloween-brew-4x5.jpg' | asset_img_url: '1080x' }}'] },
      dark: { h: 'Something good grows in <em>the dark.</em>', s: 'Lion’s Mane · Cordyceps · Reishi', pack: '18', pos: 'tl',
        alt: 'A can of Happie Fungi Fusion Watermelon in a misty forest among glowing mushrooms',
        w: ['{{ 'halloween-dark-16x9.jpg' | asset_img_url: '1280x' }}', '{{ 'halloween-dark-16x9.jpg' | asset_img_url: '1920x' }}'],
        m: ['{{ 'halloween-dark-4x5.jpg' | asset_img_url: '720x' }}', '{{ 'halloween-dark-4x5.jpg' | asset_img_url: '1080x' }}'] }
    };
    var ad = 'cauldron';
    try { var q = new URLSearchParams(window.location.search).get('ad'); if (q && HERO[q.toLowerCase()]) ad = q.toLowerCase(); } catch (e) {}
    var c = HERO[ad];
    window.hwAd = ad;
    window.hwDefaultPack = c.pack;
    var hero = document.getElementById('hw-hero');
    hero.setAttribute('data-ad', ad);
    hero.className = 'hw-hero hw-pos-' + c.pos + ' hw-dpos-' + (c.dpos || c.pos);
    if (ad !== 'cauldron') {
      document.getElementById('hw-hero-pic').innerHTML =
        '<source media="(max-width: 749px)" srcset="' + c.m[0] + ' 720w, ' + c.m[1] + ' 1080w" sizes="100vw">' +
