{%- comment -%}
  Halloween landing page (/pages/halloween), destination for the five Halloween Meta ads.
  Live until Oct 31 2026 (SPOOKY15 expires 11:59 pm Central).
  - ?ad=cauldron|boo|treat|brew|dark swaps hero image, headline and default pack (falls back to cauldron).
  - SPOOKY15 is applied in the background on load via /discount/SPOOKY15.
  - 12 = Variety Pack; 18 / 24 = Build Your Own variants, using the same line-item
    property format as sections/build-18-pack.liquid so fulfilment reads the mix the same way.
  Prices are read from the product objects, never hard-coded.
{%- endcomment -%}

{%- comment -%} Order-by date for Halloween delivery, e.g. 'October 24'. Leave blank to hide the order-by lines. {%- endcomment -%}
{%- assign hw_order_by = '' -%}

{%- assign variety = all_products['happie-fungi-fusion-mushroom-drink-variety-pack'] -%}
{%- assign byo = all_products['build-your-own-fungi-fusion-18-pack'] -%}
{%- assign v12 = variety.variants.first -%}
{%- assign v18 = blank -%}
{%- assign v24 = blank -%}
{%- for v in byo.variants -%}
  {%- if v.title contains '24' -%}{%- assign v24 = v -%}
  {%- elsif v.title contains '18' -%}{%- assign v18 = v -%}{%- endif -%}
{%- endfor -%}

{%- comment -%} 15% off. Shopify rounds the discount DOWN to the cent (checked in a live cart), so floor here to match what the cart charges. {%- endcomment -%}
{%- assign off12 = v12.price | times: 0.15 | floor -%}{%- assign now12 = v12.price | minus: off12 -%}
{%- assign off18 = v18.price | times: 0.15 | floor -%}{%- assign now18 = v18.price | minus: off18 -%}
{%- assign off24 = v24.price | times: 0.15 | floor -%}{%- assign now24 = v24.price | minus: off24 -%}
{%- assign can12 = now12 | divided_by: 12.0 | round -%}
{%- assign can18 = now18 | divided_by: 18.0 | round -%}
{%- assign can24 = now24 | divided_by: 24.0 | round -%}

{%- assign p_blue  = all_products['blue-razzberry-fungi-powered-seltzer'] -%}
{%- assign p_mango = all_products['mango-mimosa-fungi-powered-seltzer'] -%}
{%- assign p_water = all_products['watermelon-fungi-powered-seltzer'] -%}

