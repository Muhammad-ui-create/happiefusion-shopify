<style>
  /* ── Strip the site chrome on this page: logo + cart only ── */
  .announcement-bar, .site-footer, #email-popup-overlay, #happie-chatbot,
  .nav-links, .nav-signin, .hamburger, .mobile-nav, .mobile-nav-overlay,
  .cart-free-ship-note { display: none !important; }
  body { background: #0E0A14; }
  .nav-inner { max-width: 760px; }
  .nav-right { margin-left: auto; }

  .hw { --hw-bg: #0E0A14; --hw-cream: #FFF4E0; --hw-gold: #F9B040; --hw-purple: #2A1846; --hw-purple-2: #1A1028; --hw-orange: #F26B1D;
        background: var(--hw-bg); color: var(--hw-cream); font-family: Inter, system-ui, sans-serif; }
  .hw *, .hw *::before, .hw *::after { box-sizing: border-box; }
  .hw-inner { max-width: 1040px; margin: 0 auto; padding: 0 20px; }
  .hw-inner-narrow { max-width: 620px; }
  .hw-section { padding: 56px 0; }
  .hw-section-alt { background: var(--hw-purple-2); }

  /* Type */
  .hw-h1, .hw-h2 { font-family: 'DM Serif Display', Georgia, serif; font-weight: 400; color: var(--hw-cream); margin: 0; }
  .hw-h1 { font-size: clamp(38px, 9.5vw, 76px); line-height: 1.04; letter-spacing: -0.01em; text-shadow: 0 2px 24px rgba(0,0,0,0.55); }
  .hw-h1 em { font-style: normal; color: var(--hw-gold); }
  .hw-h2 { font-size: clamp(28px, 6vw, 40px); line-height: 1.12; text-align: center; }
  .hw-rule { display: block; width: 56px; height: 2px; background: var(--hw-gold); margin: 18px 0 14px; }
  .hw-sub, .hw-eyebrow { text-transform: uppercase; letter-spacing: 0.2em; font-size: 12px; font-weight: 600; margin: 0; }
  .hw-sub { color: var(--hw-cream); text-shadow: 0 1px 12px rgba(0,0,0,0.7); }
  .hw-eyebrow { color: var(--hw-gold); text-align: center; margin-bottom: 10px; }
  .hw-lede { text-align: center; color: rgba(255,244,224,0.78); font-size: 15px; margin: 10px 0 24px; }

  /* Buttons */
  .hw-btn { display: inline-flex; align-items: center; justify-content: center; min-height: 54px; padding: 14px 30px; border: 0; border-radius: 50px;
            background: var(--hw-gold); color: #17101F; font: 800 16px/1.2 Inter, system-ui, sans-serif; text-decoration: none; cursor: pointer;
            transition: transform 0.12s ease, box-shadow 0.2s ease, background 0.2s ease; box-shadow: 0 10px 28px rgba(249,176,64,0.28); }
  .hw-btn:hover { transform: translateY(-1px); background: #FFC060; }
  .hw-btn:disabled { opacity: 0.7; cursor: default; transform: none; }
  .hw-btn-hero { margin-top: 22px; }

  /* 1. Hero */
  .hw-hero { position: relative; margin-top: calc(-1 * var(--nav-h, 78px)); overflow: hidden; background: #0E0A14; }
  .hw-hero picture, .hw-hero img { display: block; width: 100%; }
  .hw-hero img { height: auto; aspect-ratio: 4 / 5; object-fit: cover; }
  .hw-hero-fade { position: absolute; inset: 0; pointer-events: none;
                  background: linear-gradient(180deg, rgba(14,10,20,0.78) 0%, rgba(14,10,20,0.35) 30%, rgba(14,10,20,0) 52%, rgba(14,10,20,0) 80%, #0E0A14 100%); }
  .hw-hero-copy { position: absolute; left: 0; right: 0; top: calc(var(--nav-h, 78px) + 14px); bottom: 26px; padding: 0 22px;
                  display: flex; flex-direction: column; align-items: flex-start; }
  .hw-hero-copy .hw-btn-hero { margin-top: auto; }
  .hw-hero-copy { z-index: 3; }
  .hw-hero-text { position: relative; isolation: isolate; }
  .hw-hero-text::before { content: ''; position: absolute; z-index: -1; inset: -34px -46px; border-radius: 50%;
                          background: radial-gradient(closest-side, rgba(14,10,20,0.78), rgba(14,10,20,0.5) 55%, rgba(14,10,20,0)); filter: blur(10px); }
  .hw-pos-tc .hw-hero-copy { text-align: center; align-items: center; }
  .hw-hero[data-ad="boo"] .hw-sub { max-width: 54%; line-height: 1.7; }
  .hw-pos-tc .hw-rule { margin-left: auto; margin-right: auto; }
  .hw-hero[data-ad="boo"] .hw-hero-fade { background: linear-gradient(180deg, rgba(14,10,20,0.92) 0%, rgba(14,10,20,0.62) 28%, rgba(14,10,20,0) 55%, rgba(14,10,20,0) 80%, #0E0A14 100%); }
  .hw-pos-bc .hw-hero-copy { text-align: center; align-items: center; justify-content: flex-end; }
  .hw-pos-bc .hw-hero-copy .hw-btn-hero { margin-top: 22px; }
  .hw-pos-bc .hw-rule { margin-left: auto; margin-right: auto; }
  .hw-pos-bc .hw-hero-fade { background: linear-gradient(180deg, rgba(14,10,20,0.45) 0%, rgba(14,10,20,0) 22%, rgba(14,10,20,0) 42%, rgba(14,10,20,0.88) 78%, #0E0A14 100%); }

  /* 2. Picker */
  .hw-picker-wrap { padding-top: 36px; scroll-margin-top: 84px; }
  .hw-packs { display: grid; gap: 12px; }
  .hw-pack { position: relative; display: flex; align-items: center; justify-content: space-between; gap: 14px; width: 100%; text-align: left;
             padding: 18px 18px; border-radius: 18px; border: 2px solid rgba(255,244,224,0.16); background: rgba(255,244,224,0.04);
             color: var(--hw-cream); font-family: inherit; cursor: pointer; transition: border-color 0.15s ease, background 0.15s ease; }
  .hw-pack.is-active { border-color: var(--hw-gold); background: rgba(249,176,64,0.10); }
  .hw-pack-main { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
  .hw-pack-cans { font-family: 'DM Serif Display', Georgia, serif; font-size: 24px; line-height: 1; }
  .hw-pack-mix { font-size: 13px; color: rgba(255,244,224,0.72); line-height: 1.35; }
  .hw-pack-price { display: flex; flex-direction: column; align-items: flex-end; gap: 2px; flex-shrink: 0; }
  .hw-now { font-size: 21px; font-weight: 800; color: var(--hw-cream); line-height: 1.1; }
  .hw-was { font-size: 13px; color: rgba(255,244,224,0.5); }
  .hw-percan { font-size: 12px; color: var(--hw-gold); font-weight: 600; }
  .hw-flag { position: absolute; top: -11px; left: 16px; background: var(--hw-orange); color: #fff; font-size: 10.5px; font-weight: 800;
             letter-spacing: 0.1em; text-transform: uppercase; padding: 4px 10px; border-radius: 50px; }
  .hw-customise { display: block; margin: 16px auto 0; background: none; border: 0; color: var(--hw-gold); font: 600 14px Inter, sans-serif;
                  text-decoration: underline; text-underline-offset: 3px; cursor: pointer; padding: 8px; }
  .hw-customise[hidden] { display: none; }
  .hw-builder { margin-top: 10px; padding: 16px; border-radius: 18px; background: var(--hw-purple); border: 1px solid rgba(255,244,224,0.12); }
  .hw-builder-status { margin: 0 0 12px; font-size: 14px; text-align: center; color: rgba(255,244,224,0.85); }
  .hw-flavours { display: grid; gap: 10px; }
  .hw-flavour { display: flex; align-items: center; gap: 12px; padding: 8px 10px; border-radius: 14px; background: rgba(14,10,20,0.45); }
  .hw-flavour img { width: 46px; height: 46px; object-fit: contain; flex-shrink: 0; }
  .hw-flavour-name { flex: 1; font-weight: 700; font-size: 15px; }
  .hw-stepper { display: inline-flex; align-items: center; gap: 12px; }
  .hw-step { width: 40px; height: 40px; border-radius: 50%; border: 0; background: var(--hw-cream); color: #17101F; font-size: 22px; font-weight: 700; line-height: 1; cursor: pointer; }
  .hw-step:disabled { opacity: 0.3; cursor: default; }
  .hw-qty { min-width: 18px; text-align: center; font-weight: 800; font-size: 17px; }
  .hw-builder-hint { margin: 12px 0 0; font-size: 12.5px; text-align: center; color: rgba(255,244,224,0.7); }
  .hw-atc { width: 100%; margin-top: 20px; min-height: 60px; font-size: 17px; }
  .hw-applied { text-align: center; font-size: 13px; color: rgba(255,244,224,0.72); margin: 12px 0 0; }
  .hw-error { text-align: center; color: #FF9A8A; font-size: 14px; margin: 10px 0 0; }

  /* 3. Facts */
  .hw-facts { background: var(--hw-purple); border-top: 1px solid rgba(255,244,224,0.1); border-bottom: 1px solid rgba(255,244,224,0.1); padding: 18px 16px; }
  .hw-facts ul { list-style: none; margin: 0 auto; padding: 0; max-width: 1040px; display: flex; flex-wrap: wrap; justify-content: center; gap: 10px 26px; }
  .hw-facts li { font-size: 12px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--hw-cream); }

  /* 4. Cards */
  .hw-cards { display: grid; gap: 14px; margin-top: 28px; }
  .hw-card { padding: 24px 22px; border-radius: 20px; background: var(--hw-purple-2); border: 1px solid rgba(255,244,224,0.1); overflow: hidden; }
  .hw-card-img { display: block; width: calc(100% + 44px); max-width: none; height: auto; aspect-ratio: 4 / 3; object-fit: cover; margin: -24px -22px 18px;
                 -webkit-mask-image: linear-gradient(180deg, #000 72%, transparent 100%); mask-image: linear-gradient(180deg, #000 72%, transparent 100%); }
  .hw-card-mg { font-family: 'DM Serif Display', Georgia, serif; font-size: 34px; color: var(--hw-gold); line-height: 1; }
  .hw-card h3 { margin: 8px 0 6px; font-size: 18px; font-weight: 800; color: var(--hw-cream); }
  .hw-card p { margin: 0; font-size: 14.5px; line-height: 1.55; color: rgba(255,244,224,0.75); }

  /* 5. Reviews */
  .hw-reviews { display: grid; gap: 14px; margin-top: 28px; }
  .hw-review { margin: 0; padding: 22px; border-radius: 20px; background: var(--hw-bg); border: 1px solid rgba(255,244,224,0.1); display: flex; flex-direction: column; gap: 12px; }
  .hw-stars { color: var(--hw-gold); letter-spacing: 2px; font-size: 15px; }
  .hw-review blockquote { margin: 0; font-size: 15px; line-height: 1.6; color: var(--hw-cream); }
  .hw-review figcaption { margin-top: auto; display: flex; flex-direction: column; gap: 2px; font-size: 13px; color: rgba(255,244,224,0.65); }
  .hw-review figcaption strong { color: var(--hw-cream); font-size: 14px; }

  /* 6-7. Order by */
  .hw-orderby { text-align: center; }
  .hw-orderby-line { font-family: 'DM Serif Display', Georgia, serif; font-size: clamp(32px, 8vw, 58px); line-height: 1.15; margin: 0 0 28px; }
  .hw-orderby .hw-btn { min-height: 66px; padding: 18px 46px; font-size: clamp(18px, 4.6vw, 21px); }
  .hw-orderby-line strong { color: var(--hw-gold); font-weight: 400; white-space: nowrap; }
  .hw-orderby-line { text-wrap: balance; }
  .hw-orderby > .hw-inner { max-width: 900px; }

  /* 8. FAQ */
  .hw-faq { border-bottom: 1px solid rgba(255,244,224,0.14); }
  .hw-faq:first-of-type { margin-top: 22px; border-top: 1px solid rgba(255,244,224,0.14); }
  .hw-faq summary { list-style: none; cursor: pointer; padding: 18px 28px 18px 0; position: relative; font-weight: 700; font-size: 16px; color: var(--hw-cream); }
  .hw-faq summary::-webkit-details-marker { display: none; }
  .hw-faq summary::after { content: '+'; position: absolute; right: 2px; top: 14px; font-size: 22px; color: var(--hw-gold); font-weight: 400; }
  .hw-faq[open] summary::after { content: '\2212'; }
  .hw-faq p { margin: 0 0 18px; font-size: 15px; line-height: 1.6; color: rgba(255,244,224,0.78); }
  .hw-smallprint { text-align: center; font-size: 12px; color: rgba(255,244,224,0.5); padding: 22px 20px 110px; margin: 0; background: var(--hw-purple-2); }

  /* Spooky layers (decorative, all aria-hidden) */
  .hw-rel, .hw-picker-wrap, .hw-orderby { position: relative; overflow: hidden; }
  .hw-rel > .hw-inner, .hw-picker-wrap > .hw-inner, .hw-orderby > .hw-inner { position: relative; z-index: 2; }
  .hw-fog { position: absolute; left: 0; right: 0; bottom: 0; height: 34%; z-index: 1; pointer-events: none; opacity: 0.5; mix-blend-mode: screen;
            background: url({{ 'halloween-fx-fog.jpg' | asset_url }}) repeat-x 0 100% / 1600px 100%; animation: hw-fog 70s linear infinite;
            -webkit-mask-image: linear-gradient(180deg, transparent 0%, #000 70%); mask-image: linear-gradient(180deg, transparent 0%, #000 70%); }
  .hw-fog-low { height: 150px; opacity: 0.4; }
  @keyframes hw-fog { to { background-position-x: -1600px; } }
  .hw-bats { position: absolute; inset: 0; z-index: 2; pointer-events: none; overflow: hidden; }
  .hw-bat { position: absolute; left: 0; width: 34px; color: #0B0710; opacity: 0.9; animation: hw-fly 17s linear infinite; }
  .hw-bat svg { display: block; width: 100%; fill: currentColor; transform-origin: 50% 40%; animation: hw-flap 0.32s ease-in-out infinite; }
  .hw-bat-1 { top: 16%; animation-delay: -2s; }
  .hw-bat-2 { top: 26%; width: 22px; animation-duration: 23s; animation-delay: -11s; }
  .hw-bat-3 { top: 9%;  width: 26px; animation-duration: 20s; animation-delay: -6s; }
  .hw-bat-4 { top: 34%; width: 18px; animation-duration: 27s; animation-delay: -18s; opacity: 0.7; }
  @keyframes hw-fly { 0% { transform: translate(-12vw, 3vh); } 25% { transform: translate(22vw, -3vh); } 50% { transform: translate(55vw, 2vh); } 75% { transform: translate(84vw, -4vh); } 100% { transform: translate(114vw, 1vh); } }
  @keyframes hw-flap { 0%, 100% { transform: scaleY(1); } 50% { transform: scaleY(0.3); } }
  .hw-embers { position: absolute; left: 0; right: 0; bottom: 0; height: 60%; z-index: 2; pointer-events: none; overflow: hidden; }
  .hw-embers i { position: absolute; bottom: -8px; width: 4px; height: 4px; border-radius: 50%; background: #FFB347; box-shadow: 0 0 8px 2px rgba(255,150,40,0.8); opacity: 0; animation: hw-ember 7s ease-in infinite; }
  .hw-embers i:nth-child(1) { left: 6%; animation-delay: 0s; }
  .hw-embers i:nth-child(2) { left: 14%; animation-delay: 2.1s; animation-duration: 9s; }
  .hw-embers i:nth-child(3) { left: 23%; animation-delay: 4.4s; }
  .hw-embers i:nth-child(4) { left: 31%; animation-delay: 1.2s; animation-duration: 8s; width: 3px; height: 3px; }
  .hw-embers i:nth-child(5) { left: 44%; animation-delay: 5.6s; }
  .hw-embers i:nth-child(6) { left: 52%; animation-delay: 3.3s; animation-duration: 10s; }
  .hw-embers i:nth-child(7) { left: 61%; animation-delay: 0.7s; width: 3px; height: 3px; }
  .hw-embers i:nth-child(8) { left: 70%; animation-delay: 6.1s; animation-duration: 8.5s; }
  .hw-embers i:nth-child(9) { left: 78%; animation-delay: 2.8s; }
  .hw-embers i:nth-child(10) { left: 86%; animation-delay: 4.9s; animation-duration: 9.5s; }
  .hw-embers i:nth-child(11) { left: 93%; animation-delay: 1.7s; width: 3px; height: 3px; }
  .hw-embers i:nth-child(12) { left: 38%; animation-delay: 7.2s; animation-duration: 11s; }
  @keyframes hw-ember { 0% { transform: translate(0, 0) scale(1); opacity: 0; } 12% { opacity: 0.9; } 100% { transform: translate(26px, -52vh) scale(0.3); opacity: 0; } }
  .hw-moon { position: absolute; left: 0; right: 0; top: 0; height: 460px; z-index: 0; pointer-events: none; opacity: 0.62;
             background: url({{ 'halloween-fx-moon.jpg' | asset_img_url: '1920x' }}) 72% top / cover no-repeat;
             -webkit-mask-image: linear-gradient(180deg, #000 30%, transparent 100%); mask-image: linear-gradient(180deg, #000 30%, transparent 100%); }
  .hw-web { position: absolute; z-index: 1; width: 150px; height: 150px; color: rgba(255,244,224,0.2); pointer-events: none; }
  .hw-web-tl { top: 0; left: 0; }
  .hw-web-tr { top: 0; right: 0; transform: scaleX(-1); }
  .hw-pumpkins { position: absolute; left: 0; right: 0; bottom: 0; height: max(32.55vw, 170px); z-index: 0; pointer-events: none; mix-blend-mode: screen;
                 background: url({{ 'halloween-fx-pumpkins.jpg' | asset_img_url: '1920x' }}) center bottom / cover no-repeat;
                 -webkit-mask-image: linear-gradient(180deg, transparent 0%, #000 14%); mask-image: linear-gradient(180deg, transparent 0%, #000 14%); }
  .hw-orderby { padding-bottom: max(28vw, 150px) !important; }
  .hw-pack.is-active { box-shadow: 0 0 0 1px rgba(249,176,64,0.35), 0 14px 44px rgba(242,107,29,0.22); }
  .hw-atc { animation: hw-glow 3.2s ease-in-out infinite; }
  @keyframes hw-glow { 0%, 100% { box-shadow: 0 10px 28px rgba(249,176,64,0.28); } 50% { box-shadow: 0 10px 40px rgba(242,107,29,0.55); } }

  /* Sticky bar */
  .hw-sticky { position: fixed; left: 0; right: 0; bottom: 0; z-index: 90; display: flex; align-items: center; justify-content: space-between; gap: 14px;
               padding: 10px 16px calc(10px + env(safe-area-inset-bottom)); background: rgba(14,10,20,0.96); border-top: 1px solid rgba(249,176,64,0.4);
               backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); }
  .hw-sticky[hidden] { display: none; }
  .hw-sticky-info { display: flex; flex-direction: column; color: #FFF4E0; font-family: Inter, sans-serif; font-size: 13px; line-height: 1.3; }
  .hw-sticky-info strong { font-size: 15px; }
  .hw-sticky-info span { color: #F9B040; font-weight: 700; }
  .hw-sticky-btn { min-height: 48px; padding: 12px 26px; font-size: 15px; }

  @media (min-width: 750px) {
    .hw-section { padding: 80px 0; }
    .hw-hero img { aspect-ratio: 16 / 9; max-height: 82vh; }
    .hw-h1 { font-size: clamp(40px, 4.8vw, 76px); }
    .hw-hero-copy { top: calc(var(--nav-h, 78px) + 6vh); bottom: auto; padding: 0 0 0 6vw; max-width: 40vw; display: block; }
    .hw-hero-copy .hw-btn-hero, .hw-pos-bc .hw-hero-copy .hw-btn-hero { margin-top: 22px; }
    .hw-hero[data-ad="boo"] .hw-sub { max-width: none; }
    .hw-pos-tc .hw-hero-copy { left: 50%; right: auto; transform: translateX(-50%); width: 100%; max-width: 760px; padding: 0 24px; }
    .hw-pos-bc .hw-hero-copy { left: 50%; right: auto; top: auto; bottom: 7vh; transform: translateX(-50%); width: 100%; max-width: 900px; padding: 0 24px; }
    /* cauldron on desktop: copy sits in the open sky on the right, clear of the cans */
    .hw-hero.hw-dpos-tr .hw-hero-copy { left: auto; right: 4vw; transform: none; width: auto; max-width: 24vw; padding: 0; text-align: left; }
    .hw-hero.hw-dpos-tr .hw-rule { margin-left: 0; margin-right: 0; }
    .hw-sub { font-size: 13px; }
    .hw-picker-wrap { padding-top: 64px; }
    .hw-cards, .hw-reviews { grid-template-columns: repeat(3, 1fr); gap: 18px; }
    .hw-sticky { display: none !important; }
    .hw-smallprint { padding-bottom: 32px; }
  }
  @media (prefers-reduced-motion: reduce) { .hw-btn, .hw-pack { transition: none; } html { scroll-behavior: auto; }
    .hw-bats, .hw-embers { display: none; } .hw-fog, .hw-atc { animation: none; } }
</style>

<script>
(function () {
  /* Same sizes, units and line-item wording as the Build Your Own builder. */
  var PACKS = {
    "12": { cans: 12, variantId: "{{ v12.id }}", cents: {{ now12 }}, price: "{{ now12 | money }}", fullCents: {{ v12.price }}, name: {{ variety.title | json }}, build: false },
    "18": { cans: 18, variantId: "{{ v18.id }}", cents: {{ now18 }}, price: "{{ now18 | money }}", fullCents: {{ v18.price }}, name: {{ byo.title | json }}, build: true, target: 3, unit: 6, unitLabel: "6-pack", mix: [1, 1, 1] },
    "24": { cans: 24, variantId: "{{ v24.id }}", cents: {{ now24 }}, price: "{{ now24 | money }}", fullCents: {{ v24.price }}, name: {{ byo.title | json }}, build: true, target: 4, unit: 6, unitLabel: "6-pack", mix: [1, 1, 2] }
  };
  var LABELS = ["Blue Raspberry", "Mango Mimosa", "Watermelon"];

  var packBtns  = Array.prototype.slice.call(document.querySelectorAll('.hw-pack'));
  var flavours  = Array.prototype.slice.call(document.querySelectorAll('.hw-flavour'));
  var atc       = document.getElementById('hw-atc');
  var atcText   = document.getElementById('hw-atc-text');
  var custom    = document.getElementById('hw-customise');
  var builder   = document.getElementById('hw-builder');
  var countEl   = document.getElementById('hw-count');
  var targetEl  = document.getElementById('hw-target');
  var hintEl    = document.getElementById('hw-builder-hint');
  var errEl     = document.getElementById('hw-error');
  var sticky    = document.getElementById('hw-sticky');
  var stickyBtn = document.getElementById('hw-sticky-atc');
  if (!atc || !packBtns.length) return;

  var size = PACKS[window.hwDefaultPack] ? window.hwDefaultPack : "18";
  var counts = { "18": PACKS["18"].mix.slice(), "24": PACKS["24"].mix.slice() };
  var busy = false;

  /* Apply SPOOKY15 in the background; add-to-cart waits for it so the cart shows the discount. */
  var discountReady = fetch('/discount/SPOOKY15?redirect=%2Fcart.js', { credentials: 'same-origin' }).catch(function () {});

  /* Carry the ad and utm_ parameters onto the cart so they reach the order. */
  try {
    var attrs = { halloween_ad: window.hwAd || 'cauldron' };
    new URLSearchParams(window.location.search).forEach(function (v, k) { if (k.indexOf('utm_') === 0 && v) attrs[k] = v.slice(0, 120); });
    discountReady.then(function () {
      fetch('/cart/update.js', { method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' }, body: JSON.stringify({ attributes: attrs }) }).catch(function () {});
    });
  } catch (e) {}

  function cfg() { return PACKS[size]; }
  function total() { return counts[size].reduce(function (a, b) { return a + b; }, 0); }
  function mixText(s) {
    var c = counts[s], u = PACKS[s].unit, parts = [];
    if (c[0] === c[1] && c[1] === c[2]) return (c[0] * u) + ' of each flavour';
    [2, 1, 0].forEach(function (i) { if (c[i] > 0) parts.push((c[i] * u) + ' ' + LABELS[i]); });
    return parts.join(', ');
  }

  function render() {
    var c = cfg();
    packBtns.forEach(function (b) {
      var on = b.dataset.pack === size;
      b.classList.toggle('is-active', on);
      b.setAttribute('aria-checked', on ? 'true' : 'false');
    });
    ["18", "24"].forEach(function (s) {
      var el = document.querySelector('[data-mix-label="' + s + '"]');
      if (el) el.textContent = mixText(s);
    });
    custom.hidden = !c.build;
    if (!c.build) { builder.hidden = true; custom.setAttribute('aria-expanded', 'false'); }
    var complete = true;
    if (c.build) {
      var t = total();
      complete = t === c.target;
      countEl.textContent = t;
      targetEl.textContent = c.target;
      flavours.forEach(function (f, i) {
        f.querySelector('[data-count]').textContent = counts[size][i];
        f.querySelector('.hw-minus').disabled = counts[size][i] === 0;
        f.querySelector('.hw-plus').disabled = t >= c.target;
      });
      hintEl.textContent = complete ? 'Each step is one six-pack.' : 'Add ' + (c.target - t) + ' more six-pack' + (c.target - t === 1 ? '' : 's') + ' to fill the box.';
    }
    if (!busy) {
      atc.disabled = !complete;
      stickyBtn.disabled = !complete;
      atcText.innerHTML = complete ? 'Add ' + c.cans + ' cans to cart &middot; ' + c.price : 'Finish your mix to continue';
    }
    document.getElementById('hw-sticky-cans').textContent = c.cans + ' cans';
    document.getElementById('hw-sticky-price').textContent = c.price;
  }

  packBtns.forEach(function (b) {
    b.addEventListener('click', function () { size = b.dataset.pack; render(); });
  });
  custom.addEventListener('click', function () {
    builder.hidden = !builder.hidden;
    custom.setAttribute('aria-expanded', builder.hidden ? 'false' : 'true');
    custom.textContent = builder.hidden ? 'Customise your mix' : 'Hide the flavour picker';
  });
  flavours.forEach(function (f, i) {
    f.querySelector('.hw-plus').addEventListener('click', function () { if (total() < cfg().target) { counts[size][i]++; render(); } });
    f.querySelector('.hw-minus').addEventListener('click', function () { if (counts[size][i] > 0) { counts[size][i]--; render(); } });
  });

  function addToCart() {
    var c = cfg();
    if (busy || (c.build && total() !== c.target)) return;
    var body = { id: c.variantId, quantity: 1 };
    if (c.build) {
      var properties = {};
      flavours.forEach(function (f, i) {
        if (counts[size][i] > 0) properties[f.dataset.flavor] = counts[size][i] + ' × ' + c.unitLabel + ' (' + (counts[size][i] * c.unit) + ' cans)';
      });
      body.properties = properties;
    }
    busy = true; errEl.hidden = true;
    atc.disabled = true; stickyBtn.disabled = true;
    atcText.textContent = 'Adding…';
    discountReady.then(function () {
      return fetch('/cart/add.js', { method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' }, body: JSON.stringify(body) });
    }).then(function (r) {
      if (!r.ok) throw new Error('add failed');
      return r.json();
    }).then(function () {
      atcText.textContent = '✓ Added to cart';
      try {
        if (window.fbq) fbq('track', 'AddToCart', { content_ids: [String(c.variantId)], content_type: 'product', content_name: c.name, value: c.cents / 100, currency: 'USD', num_items: 1 });
      } catch (e) {}
      var trigger = document.getElementById('cart-trigger');
      if (trigger) trigger.click();
      setTimeout(function () { busy = false; render(); }, 1800);
    }).catch(function () {
      busy = false; render();
      errEl.textContent = 'That did not go through. Please try again.';
      errEl.hidden = false;
    });
  }
  atc.addEventListener('click', addToCart);
  stickyBtn.addEventListener('click', addToCart);

  /* Sticky bar appears once the main button has scrolled out of view (mobile only via CSS). */
  if ('IntersectionObserver' in window) {
    new IntersectionObserver(function (entries) {
      var e = entries[0];
      sticky.hidden = e.isIntersecting || e.boundingClientRect.top > 0;
    }, { threshold: 0 }).observe(atc);
  }

  render();
})();
</script>
