{%- comment -%}
  Recipes page (/pages/recipes), linked from the header nav.
  Generated from one recipe list (scratchpad build_recipes_page.py). Every card links to its full write-up
  in the blog post via the anchor id on that post's heading. Copy stays within the FF claims rules:
  taste and occasion only, no effect claims, no calorie numbers.
{%- endcomment -%}
{%- assign rc_flavors = 'watermelon-fungi-powered-seltzer|mango-mimosa-fungi-powered-seltzer|blue-razzberry-fungi-powered-seltzer' | split: '|' -%}
{%- assign rc_names = 'Watermelon|Mango Mimosa|Blue Raspberry' | split: '|' -%}
{%- assign rc_keys = 'watermelon|mango|blue' | split: '|' -%}
{%- assign post_new = articles['news/mushroom-mocktail-recipes'] -%}
{%- assign post_old = articles['news/mushroom-mocktails'] -%}

<div class="rc">
  <section class="rc-hero">
    <img class="rc-hero-img" src="https://cdn.shopify.com/s/files/1/0725/4946/6177/files/fungi-fusion-recipes-banner.png?width=2000" srcset="https://cdn.shopify.com/s/files/1/0725/4946/6177/files/fungi-fusion-recipes-banner.png?width=900 900w, https://cdn.shopify.com/s/files/1/0725/4946/6177/files/fungi-fusion-recipes-banner.png?width=1400 1400w, https://cdn.shopify.com/s/files/1/0725/4946/6177/files/fungi-fusion-recipes-banner.png?width=2000 2000w" sizes="100vw" alt="Mocktails and fresh garnishes on a kitchen counter with Happie Fungi Fusion Blue Raspberry, Mango Mimosa and Watermelon cans" width="2000" height="1116" fetchpriority="high">
    <div class="rc-hero-copy">
      <p class="rc-eyebrow">Fungi Fusion Recipes</p>
      <h1>Mocktails that start with a cold can.</h1>
      <p class="rc-sub">Easy alcohol-free drinks built on Happie Fungi Fusion. Fresh citrus, a garnish, plenty of ice, and you're done in about two minutes.</p>
      <div class="rc-hero-ctas">
        <a class="rc-btn rc-btn--solid" href="#rc-grid">Browse recipes</a>
        <a class="rc-btn rc-btn--ghost" href="/products/happie-fungi-fusion-mushroom-drink-variety-pack">Shop the Variety Pack</a>
      </div>
    </div>
  </section>

  <section class="rc-wrap" id="rc-grid">
    <div class="rc-head">
      <h2>All recipes</h2>
      <div class="rc-filters" role="group" aria-label="Filter recipes">
        <button type="button" class="rc-chip is-on" data-filter="all" aria-pressed="true">All</button>
        <button type="button" class="rc-chip" data-filter="watermelon" aria-pressed="false">Watermelon</button>
        <button type="button" class="rc-chip" data-filter="mango" aria-pressed="false">Mango Mimosa</button>
        <button type="button" class="rc-chip" data-filter="blue" aria-pressed="false">Blue Raspberry</button>
        <button type="button" class="rc-chip" data-filter="batch" aria-pressed="false">Big batch</button>
      </div>
    </div>
    <div class="rc-grid">
      <article class="rc-card" id="watermelon-rosemary-spritz" data-flavor="watermelon">
        <div class="rc-img"><img src="https://cdn.shopify.com/s/files/1/0725/4946/6177/files/watermelon-rosemary-spritz-mocktail.png?width=700" alt="Watermelon Rosemary Spritz mocktail made with Happie Fungi Fusion Watermelon" width="700" height="869" loading="lazy"></div>
        <div class="rc-body">
          <span class="rc-flavor rc-flavor--watermelon">Watermelon</span>
          <h3>Watermelon Rosemary Spritz</h3>
          <p class="rc-meta"><span>Serves 1 drink</span><span>2 min</span></p>
          <p class="rc-blurb">Pink, herbal and pretty enough to set at every place on the Thanksgiving table.</p>
          <details class="rc-more">
            <summary>See the recipe</summary>
            <h4>You'll need</h4><ul><li>Ice</li><li>1/2 oz fresh lime juice</li><li>1 can Watermelon Fungi Fusion, chilled</li><li>1 sprig fresh rosemary</li></ul>
            <h4>How to make it</h4><ol><li>Fill a wine glass with ice and add the lime juice.</li><li>Pour in the Watermelon Fungi Fusion and stir once.</li><li>Slap the rosemary sprig between your palms to wake up the oils, then tuck it into the glass.</li></ol>
            <a class="rc-post" href="/blogs/news/mushroom-mocktail-recipes#watermelon-rosemary-spritz">Read the full post &rarr;</a>
          </details>
        </div>
      </article>
      <article class="rc-card" id="mango-mimosa-brunch-fizz" data-flavor="mango">
        <div class="rc-img"><img src="https://cdn.shopify.com/s/files/1/0725/4946/6177/files/mango-mimosa-brunch-fizz-mocktail.png?width=700" alt="Mango Mimosa Brunch Fizz mocktail made with Happie Fungi Fusion Mango Mimosa" width="700" height="869" loading="lazy"></div>
        <div class="rc-body">
          <span class="rc-flavor rc-flavor--mango">Mango Mimosa</span>
          <h3>Mango Mimosa Brunch Fizz</h3>
          <p class="rc-meta"><span>Serves 1 drink</span><span>2 min</span></p>
          <p class="rc-blurb">The flute-in-hand brunch moment, without the sparkling wine.</p>
          <details class="rc-more">
            <summary>See the recipe</summary>
            <h4>You'll need</h4><ul><li>2 oz fresh orange juice</li><li>Mango Mimosa Fungi Fusion, chilled, to top</li><li>Thin orange wheel</li></ul>
            <h4>How to make it</h4><ol><li>Pour the orange juice into a champagne flute.</li><li>Top with chilled Mango Mimosa Fungi Fusion.</li><li>Garnish with a thin orange wheel.</li></ol>
            <a class="rc-post" href="/blogs/news/mushroom-mocktail-recipes#mango-mimosa-brunch-fizz">Read the full post &rarr;</a>
          </details>
        </div>
      </article>
      <article class="rc-card" id="blue-raspberry-cranberry-smash" data-flavor="blue">
        <div class="rc-img"><img src="https://cdn.shopify.com/s/files/1/0725/4946/6177/files/blue-raspberry-cranberry-smash-mocktail.png?width=700" alt="Blue Raspberry Cranberry Smash mocktail made with Happie Fungi Fusion Blue Raspberry" width="700" height="869" loading="lazy"></div>
        <div class="rc-body">
          <span class="rc-flavor rc-flavor--blue">Blue Raspberry</span>
          <h3>Blue Raspberry Cranberry Smash</h3>
          <p class="rc-meta"><span>Serves 1 drink</span><span>3 min</span></p>
          <p class="rc-blurb">Tart cranberry against Blue Raspberry. Deep ruby red and made for December parties.</p>
          <details class="rc-more">
            <summary>See the recipe</summary>
            <h4>You'll need</h4><ul><li>Small handful fresh raspberries</li><li>1/2 oz fresh lemon juice</li><li>1 oz unsweetened cranberry juice</li><li>Ice</li><li>Blue Raspberry Fungi Fusion, chilled, to top</li><li>Whole raspberries and a lemon twist</li></ul>
            <h4>How to make it</h4><ol><li>Muddle the raspberries with the lemon juice in a rocks glass.</li><li>Add the cranberry juice and fill with ice.</li><li>Top with Blue Raspberry Fungi Fusion.</li><li>Garnish with whole raspberries and a lemon twist.</li></ol>
            <a class="rc-post" href="/blogs/news/mushroom-mocktail-recipes#blue-raspberry-cranberry-smash">Read the full post &rarr;</a>
          </details>
        </div>
      </article>
      <article class="rc-card" id="watermelon-pomegranate-punch" data-flavor="watermelon" data-batch="1">
        <div class="rc-img"><img src="https://cdn.shopify.com/s/files/1/0725/4946/6177/files/watermelon-pomegranate-punch-mocktail.png?width=700" alt="Watermelon Pomegranate Punch mocktail made with Happie Fungi Fusion Watermelon" width="700" height="869" loading="lazy"><span class="rc-tag rc-tag--batch">Big batch</span></div>
        <div class="rc-body">
          <span class="rc-flavor rc-flavor--watermelon">Watermelon</span>
          <h3>Watermelon Pomegranate Punch</h3>
          <p class="rc-meta"><span>Serves 8 to 10</span><span>5 min</span></p>
          <p class="rc-blurb">One bowl, everyone serves themselves, and the whole thing is alcohol-free.</p>
          <details class="rc-more">
            <summary>See the recipe</summary>
            <h4>You'll need</h4><ul><li>1 cup pomegranate juice</li><li>Juice of 2 limes</li><li>Handful of fresh pomegranate arils</li><li>4 cans Watermelon Fungi Fusion, chilled</li><li>A tray of ice</li><li>Thin lime and orange wheels</li></ul>
            <h4>How to make it</h4><ol><li>Combine the pomegranate juice, lime juice and pomegranate arils in a large pitcher or punch bowl.</li><li>Just before guests arrive, add the Watermelon Fungi Fusion and the ice.</li><li>Float the lime and orange wheels on top.</li></ol>
            <a class="rc-post" href="/blogs/news/mushroom-mocktail-recipes#watermelon-pomegranate-punch">Read the full post &rarr;</a>
          </details>
        </div>
      </article>
      <article class="rc-card" id="fresh-ginger-mango-mule" data-flavor="mango">
        <div class="rc-img"><img src="https://cdn.shopify.com/s/files/1/0725/4946/6177/files/fresh-ginger-mango-mule-mocktail.png?width=700" alt="Fresh Ginger Mango Mule mocktail made with Happie Fungi Fusion Mango Mimosa" width="700" height="869" loading="lazy"></div>
        <div class="rc-body">
          <span class="rc-flavor rc-flavor--mango">Mango Mimosa</span>
          <h3>Fresh Ginger Mango Mule</h3>
          <p class="rc-meta"><span>Serves 1 drink</span><span>3 min</span></p>
          <p class="rc-blurb">For the guest who would have ordered a Moscow Mule. Fresh ginger brings the kick.</p>
          <details class="rc-more">
            <summary>See the recipe</summary>
            <h4>You'll need</h4><ul><li>3 thin coins fresh ginger</li><li>1/2 oz fresh lime juice</li><li>Crushed ice</li><li>Mango Mimosa Fungi Fusion, chilled, to top</li><li>Lime wedge and a mint sprig</li></ul>
            <h4>How to make it</h4><ol><li>Muddle the ginger with the lime juice in a copper mug or highball glass.</li><li>Fill with crushed ice.</li><li>Top with Mango Mimosa Fungi Fusion.</li><li>Garnish with a lime wedge and a sprig of mint.</li></ol>
            <a class="rc-post" href="/blogs/news/mushroom-mocktail-recipes#fresh-ginger-mango-mule">Read the full post &rarr;</a>
          </details>
        </div>
      </article>
      <article class="rc-card" id="watermelon-mint-spritz" data-flavor="watermelon">
        <div class="rc-img"><img src="https://cdn.shopify.com/s/files/1/0725/4946/6177/files/watermelon-mint-spritz-mocktail.png?width=700" alt="Watermelon Mint Spritz mocktail made with Happie Fungi Fusion Watermelon" width="700" height="869" loading="lazy"></div>
        <div class="rc-body">
          <span class="rc-flavor rc-flavor--watermelon">Watermelon</span>
          <h3>Watermelon Mint Spritz</h3>
          <p class="rc-meta"><span>Serves 1 drink</span><span>2 min</span></p>
          <p class="rc-blurb">Bright, cool and very pink. Light enough to sip between bites.</p>
          <details class="rc-more">
            <summary>See the recipe</summary>
            <h4>You'll need</h4><ul><li>6 fresh mint leaves</li><li>1/2 oz fresh lime juice</li><li>Ice</li><li>1 can Watermelon Fungi Fusion, chilled</li><li>Lime wheel and a mint sprig</li></ul>
            <h4>How to make it</h4><ol><li>Gently press the mint leaves with the lime juice in the bottom of a tall glass.</li><li>Fill with ice, top with Watermelon and stir once.</li><li>Garnish with the lime wheel and mint sprig.</li></ol>
            <a class="rc-post" href="/blogs/news/mushroom-mocktails#watermelon-mint-spritz">Read the full post &rarr;</a>
          </details>
        </div>
      </article>
      <article class="rc-card" id="zero-proof-mango-mimosa" data-flavor="mango">
        <div class="rc-img"><img src="https://cdn.shopify.com/s/files/1/0725/4946/6177/files/zero-proof-mango-mimosa-mocktail.png?width=700" alt="The Zero-Proof Mango Mimosa mocktail made with Happie Fungi Fusion Mango Mimosa" width="700" height="869" loading="lazy"></div>
        <div class="rc-body">
          <span class="rc-flavor rc-flavor--mango">Mango Mimosa</span>
          <h3>The Zero-Proof Mango Mimosa</h3>
          <p class="rc-meta"><span>Serves 1 drink</span><span>1 min</span></p>
          <p class="rc-blurb">The easiest drink on the list. Fungi Fusion Mango Mimosa was made for this.</p>
          <details class="rc-more">
            <summary>See the recipe</summary>
            <h4>You'll need</h4><ul><li>2 oz chilled orange juice</li><li>About half a can Mango Mimosa Fungi Fusion, well chilled</li><li>Orange twist</li></ul>
            <h4>How to make it</h4><ol><li>Pour the orange juice into a champagne flute.</li><li>Tilt the glass and slowly top with Mango Mimosa.</li><li>Twist the orange peel over the glass and drop it in.</li></ol>
            <a class="rc-post" href="/blogs/news/mushroom-mocktails#zero-proof-mango-mimosa">Read the full post &rarr;</a>
          </details>
        </div>
      </article>
      <article class="rc-card" id="blue-raspberry-blueberry-holiday-punch" data-flavor="blue" data-batch="1">
        <div class="rc-img"><img src="https://cdn.shopify.com/s/files/1/0725/4946/6177/files/blue-raspberry-holiday-punch.png?width=700" alt="Blue Raspberry Holiday Punch mocktail made with Happie Fungi Fusion Blue Raspberry" width="700" height="869" loading="lazy"><span class="rc-tag rc-tag--batch">Big batch</span></div>
        <div class="rc-body">
          <span class="rc-flavor rc-flavor--blue">Blue Raspberry</span>
          <h3>Blue Raspberry Holiday Punch</h3>
          <p class="rc-meta"><span>Serves 8</span><span>5 min</span></p>
          <p class="rc-blurb">A big-batch punch so you&#x27;re not playing bartender all night.</p>
          <details class="rc-more">
            <summary>See the recipe</summary>
            <h4>You'll need</h4><ul><li>4 cans Blue Raspberry Fungi Fusion, chilled</li><li>2 cups white cranberry juice, chilled</li><li>1/4 cup fresh lemon juice</li><li>1 cup frozen blueberries</li><li>3 or 4 rosemary sprigs</li><li>Lemon slices</li></ul>
            <h4>How to make it</h4><ol><li>Stir the white cranberry juice and lemon juice together in a punch bowl or large pitcher.</li><li>Add the frozen blueberries, rosemary and lemon slices.</li><li>Right before guests arrive, slowly pour in the Blue Raspberry so it stays fizzy. Serve over ice.</li></ol>
            <a class="rc-post" href="/blogs/news/mushroom-mocktails#blue-raspberry-blueberry-holiday-punch">Read the full post &rarr;</a>
          </details>
        </div>
      </article>
      <article class="rc-card" id="watermelon-cranberry-rosemary-sparkler" data-flavor="watermelon">
        <div class="rc-img"><img src="https://cdn.shopify.com/s/files/1/0725/4946/6177/files/watermelon-cranberry-rosemary-sparkler.png?width=700" alt="Watermelon Cranberry Rosemary Sparkler mocktail made with Happie Fungi Fusion Watermelon" width="700" height="869" loading="lazy"></div>
        <div class="rc-body">
          <span class="rc-flavor rc-flavor--watermelon">Watermelon</span>
          <h3>Watermelon Cranberry Rosemary Sparkler</h3>
          <p class="rc-meta"><span>Serves 1 drink</span><span>2 min</span></p>
          <p class="rc-blurb">Red, green and very holiday. Looks fancy, takes two minutes.</p>
          <details class="rc-more">
            <summary>See the recipe</summary>
            <h4>You'll need</h4><ul><li>2 oz unsweetened cranberry juice</li><li>1/4 oz honey or simple syrup (optional)</li><li>Ice</li><li>About half a can Watermelon Fungi Fusion, chilled</li><li>Rosemary sprig and a few fresh cranberries</li></ul>
            <h4>How to make it</h4><ol><li>Stir the cranberry juice and honey together in a wine glass until the honey dissolves.</li><li>Add ice and top with Watermelon.</li><li>Garnish with the rosemary sprig and cranberries.</li></ol>
            <a class="rc-post" href="/blogs/news/mushroom-mocktails#watermelon-cranberry-rosemary-sparkler">Read the full post &rarr;</a>
          </details>
        </div>
      </article>
      <article class="rc-card" id="mango-ginger-mule" data-flavor="mango">
        <div class="rc-img"><img src="https://cdn.shopify.com/s/files/1/0725/4946/6177/files/mango-ginger-mule-mocktail.png?width=700" alt="Mango Ginger Mule mocktail made with Happie Fungi Fusion Mango Mimosa" width="700" height="869" loading="lazy"></div>
        <div class="rc-body">
          <span class="rc-flavor rc-flavor--mango">Mango Mimosa</span>
          <h3>Mango Ginger Mule</h3>
          <p class="rc-meta"><span>Serves 1 drink</span><span>2 min</span></p>
          <p class="rc-blurb">A holiday take on the classic mule, with ginger beer and tropical mango.</p>
          <details class="rc-more">
            <summary>See the recipe</summary>
            <h4>You'll need</h4><ul><li>Crushed ice</li><li>1/2 oz fresh lime juice</li><li>2 oz non-alcoholic ginger beer</li><li>About half a can Mango Mimosa Fungi Fusion, chilled</li><li>Lime wedge and a slice of candied ginger</li></ul>
            <h4>How to make it</h4><ol><li>Fill a copper mug or rocks glass with crushed ice.</li><li>Add the lime juice and ginger beer, then top with Mango Mimosa.</li><li>Stir gently and garnish. (Check the ginger beer label: a few brands sell an alcoholic version.)</li></ol>
            <a class="rc-post" href="/blogs/news/mushroom-mocktails#mango-ginger-mule">Read the full post &rarr;</a>
          </details>
        </div>
      </article>
    </div>
    <p class="rc-tip"><strong>Host tip:</strong> chill the cans overnight, build every drink over plenty of ice, and pour the Fungi Fusion last so it keeps its fizz.</p>
  </section>

  <section class="rc-wrap rc-base">
    <p class="rc-eyebrow">The base</p>
    <h2>Pick your flavor</h2>
    <div class="rc-base-grid">
      {%- for h in rc_flavors -%}
        {%- assign fp = all_products[h] -%}
        {%- if fp != blank -%}
        <a class="rc-base-card rc-base-card--{{ rc_keys[forloop.index0] }}" href="{{ fp.url }}">
          {%- if fp.featured_image -%}<img src="{{ fp.featured_image | image_url: width: 500 }}" alt="Happie Fungi Fusion {{ rc_names[forloop.index0] }}" width="500" height="500" loading="lazy">{%- endif -%}
          <span class="rc-base-name">{{ rc_names[forloop.index0] }}</span>
          <span class="rc-base-price">From {{ fp.price_min | money }}</span>
        </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </section>

  <section class="rc-wrap rc-reads">
    <p class="rc-eyebrow">From the blog</p>
    <h2>The full write-ups</h2>
    <div class="rc-reads-grid">
      {%- for a in (1..2) -%}
        {%- if forloop.first -%}{%- assign p = post_new -%}{%- else -%}{%- assign p = post_old -%}{%- endif -%}
        {%- if p != blank -%}
        <a class="rc-read" href="{{ p.url }}">
          {%- if p.image -%}<img src="{{ p.image | image_url: width: 900 }}" alt="{{ p.image.alt | default: p.title | escape }}" width="900" height="600" loading="lazy">{%- endif -%}
          <span class="rc-read-title">{{ p.title }}</span>
          <span class="rc-read-link">Read the post &rarr;</span>
        </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </section>
</div>

