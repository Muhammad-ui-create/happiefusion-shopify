{%- comment -%}
  Latest-from-the-blog feed for the homepage (sits above the global footer).
  Pulls the newest articles from the chosen blog (defaults to "news").
{%- endcomment -%}

{%- assign feed = blogs.news -%}
{%- assign limit = 3 -%}

{%- if feed.articles.size > 0 -%}
<section class="blogfeed">
  <div class="blogfeed-inner">
    <div class="blogfeed-head">
      <div class="blogfeed-eyebrow">The Journal</div>
      <h2 class="blogfeed-title">Fresh from the Happie blog</h2>
      <p class="blogfeed-sub">Functional-mushroom deep dives, drink-swap ideas, and the science behind the can.</p>
    </div>

    <div class="blogfeed-grid">
      {%- for article in feed.articles limit: limit -%}
        <a href="{{ article.url }}" class="blogfeed-card">
          <div class="blogfeed-card-img">
            {%- if article.image -%}
              <img src="{{ article.image | image_url: width: 640 }}"
                   srcset="{{ article.image | image_url: width: 320 }} 320w, {{ article.image | image_url: width: 640 }} 640w"
                   sizes="(max-width: 768px) 92vw, 360px"
                   alt="{{ article.image.alt | default: article.title }}"
                   width="640" height="400" loading="lazy" />
            {%- else -%}
              <div class="blogfeed-card-noimg" aria-hidden="true">🍄</div>
            {%- endif -%}
          </div>
          <div class="blogfeed-card-body">
            <div class="blogfeed-card-meta">{{ article.published_at | date: '%b %d, %Y' }}{% if article.tags.size > 0 %} · {{ article.tags.first }}{% endif %}</div>
            <h3 class="blogfeed-card-title">{{ article.title }}</h3>
            <p class="blogfeed-card-excerpt">{{ article.excerpt_or_content | strip_html | truncate: 120 }}</p>
            <span class="blogfeed-card-link">Read more →</span>
          </div>
        </a>
      {%- endfor -%}
    </div>

    <div class="blogfeed-cta">
      <a href="{{ feed.url }}" class="btn-ghost">View all posts ↗</a>
    </div>
  </div>
</section>

<style>
.blogfeed { background: #fff; }
.blogfeed-inner { max-width: 1200px; margin: 0 auto; padding: 80px 24px; }
.blogfeed-head { text-align: center; margin-bottom: 44px; }
.blogfeed-eyebrow { font-size: 11px; font-weight: 800; letter-spacing: 0.14em; text-transform: uppercase; color: var(--green, #2D6A4F); margin-bottom: 10px; }
.blogfeed-title { font-size: clamp(26px,4vw,42px); font-weight: 900; letter-spacing: -0.02em; margin-bottom: 12px; }
.blogfeed-sub { font-size: 16px; color: var(--gray, #6B6B6B); max-width: 560px; margin: 0 auto; line-height: 1.6; }
.blogfeed-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 26px; }
.blogfeed-card {
  display: flex; flex-direction: column;
  background: #fff; border: 1px solid rgba(0,0,0,0.08); border-radius: 20px; overflow: hidden;
  text-decoration: none; color: inherit;
  box-shadow: 0 2px 14px rgba(0,0,0,0.05);
  transition: transform 0.18s cubic-bezier(0.16,1,0.3,1), box-shadow 0.18s;
}
.blogfeed-card:hover { transform: translateY(-4px); box-shadow: 0 16px 36px rgba(0,0,0,0.12); }
.blogfeed-card-img { aspect-ratio: 16/10; background: #F3F4F2; overflow: hidden; }
.blogfeed-card-img img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.3s; }
.blogfeed-card:hover .blogfeed-card-img img { transform: scale(1.04); }
.blogfeed-card-noimg { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; font-size: 54px;
  background: linear-gradient(135deg, #EAF6F0, #F3EEFB); }
.blogfeed-card-body { padding: 22px 22px 24px; display: flex; flex-direction: column; flex: 1; }
.blogfeed-card-meta { font-size: 12px; font-weight: 700; letter-spacing: 0.03em; text-transform: uppercase; color: var(--green, #2D6A4F); margin-bottom: 10px; }
.blogfeed-card-title { font-size: 19px; font-weight: 800; line-height: 1.28; margin-bottom: 10px; color: #16181B; }
.blogfeed-card-excerpt { font-size: 14px; color: #555; line-height: 1.6; margin-bottom: 16px; flex: 1; }
.blogfeed-card-link { font-size: 14px; font-weight: 800; color: var(--green-dark, #2D6A4F); }
.blogfeed-cta { text-align: center; margin-top: 44px; }

@media (max-width: 900px) { .blogfeed-grid { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 620px) {
  .blogfeed-inner { padding: 56px 16px; }
  .blogfeed-grid { grid-template-columns: 1fr; gap: 18px; }
}
</style>
{%- endif -%}

{% schema %}
{ "name": "Blog Feed", "settings": [] }
{% endschema %}
