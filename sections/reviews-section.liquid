<style>
.review-card-top { display:flex; justify-content:space-between; align-items:center; margin-bottom:8px; }
.review-title { font-size:13px; font-weight:800; color:#111; margin-bottom:8px; }
.rv-flavor-tag { font-size:10px; font-weight:800; letter-spacing:0.07em; text-transform:uppercase; padding:3px 10px; border-radius:50px; flex-shrink:0; }
.rv-blue { background:rgba(59,111,240,0.1); color:#2855D4; }
.rv-watermelon { background:rgba(232,76,107,0.1); color:#C03060; }
.rv-mango { background:rgba(245,166,35,0.12); color:#B8730A; }
.reviewer-tag { display:flex; align-items:center; gap:4px; font-size:11px; color:#888; margin-top:2px; }
.reviewer-avatar { width:36px; height:36px; border-radius:50%; color:#fff; font-size:12px; font-weight:800; display:flex; align-items:center; justify-content:center; flex-shrink:0; background:var(--green-dark); }

/* ── Reviews carousel (desktop + mobile) ── */
.reviews-carousel { position: relative; }
.reviews-grid {
  display: flex !important;
  grid-template-columns: none !important;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  gap: 22px;
  scroll-behavior: smooth;
  -webkit-overflow-scrolling: touch;
  padding: 6px 2px 22px;
  scrollbar-width: none;
}
.reviews-grid::-webkit-scrollbar { display: none; }
.reviews-grid .review-card {
  flex: 0 0 clamp(280px, 30%, 360px);
  scroll-snap-align: center;
}
.rev-arrow {
  position: absolute; top: 46%; transform: translateY(-50%);
  z-index: 4; width: 46px; height: 46px; border-radius: 50%;
  border: none; background: #fff; color: var(--green-dark, #1B4332);
  box-shadow: 0 6px 22px rgba(0,0,0,0.16); cursor: pointer;
  font-size: 28px; line-height: 1; display: flex; align-items: center; justify-content: center;
  transition: transform .15s, background .15s, color .15s;
}
.rev-arrow:hover { background: var(--green, #2D6A4F); color: #fff; transform: translateY(-50%) scale(1.06); }
.rev-arrow-prev { left: -10px; }
.rev-arrow-next { right: -10px; }
.rev-dots { display: flex; justify-content: center; gap: 8px; margin-top: 6px; }
.rev-dots button { width: 8px; height: 8px; border-radius: 50%; border: none; background: rgba(0,0,0,0.18); padding: 0; cursor: pointer; transition: background .2s, transform .2s; }
.rev-dots button.is-active { background: var(--green, #2D6A4F); transform: scale(1.35); }
@media (max-width: 768px) {
  .reviews-grid .review-card { flex: 0 0 84%; }
  .rev-arrow { display: none; }
}
</style>
<script>
(function(){
  var track = document.getElementById('reviews-track');
  if(!track) return;
  var cards = track.querySelectorAll('.review-card');
  var dotsWrap = document.getElementById('rev-dots');
  var prev = document.querySelector('.rev-arrow-prev');
  var next = document.querySelector('.rev-arrow-next');
  function step(){ var c = cards[0]; return c ? c.getBoundingClientRect().width + 22 : track.clientWidth; }
  if(prev) prev.addEventListener('click', function(){ track.scrollBy({left:-step(), behavior:'smooth'}); });
  if(next) next.addEventListener('click', function(){ track.scrollBy({left:step(), behavior:'smooth'}); });
  if(dotsWrap){
    cards.forEach(function(c,i){
      var b=document.createElement('button'); b.type='button'; b.setAttribute('aria-label','Go to review '+(i+1));
      b.addEventListener('click', function(){ track.scrollTo({left: c.offsetLeft - track.offsetLeft, behavior:'smooth'}); });
      dotsWrap.appendChild(b);
    });
    var dots = dotsWrap.querySelectorAll('button');
    function update(){
      var center = track.scrollLeft + track.clientWidth/2, best=0, bestD=Infinity;
      cards.forEach(function(c,i){ var cc=c.offsetLeft + c.clientWidth/2 - track.offsetLeft; var d=Math.abs(cc-center); if(d<bestD){bestD=d;best=i;} });
      dots.forEach(function(d,i){ d.classList.toggle('is-active', i===best); });
    }
    track.addEventListener('scroll', function(){ window.requestAnimationFrame(update); }, {passive:true});
    update();
  }
})();
</script>

