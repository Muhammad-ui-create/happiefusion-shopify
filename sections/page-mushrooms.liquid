          <p style="color:rgba(255,255,255,0.65);font-size:13px;">The actual mushroom — not grain-grown mycelium</p>
        </div>
        <div style="background:rgba(255,255,255,0.08);border-radius:16px;padding:28px 20px;border:1px solid rgba(255,255,255,0.12);">
          <div style="display:flex;justify-content:center;margin-bottom:12px;">
            <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#52B788" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3C12 3 5 10.5 5 15a7 7 0 0 0 14 0c0-4.5-7-12-7-12z"/><path d="M9.5 16.5a3.5 3.5 0 0 0 3.5 2"/></svg>
          </div>
          <strong style="color:#fff;display:block;margin-bottom:6px;">Dual Extracted</strong>
          <p style="color:rgba(255,255,255,0.65);font-size:13px;">Hot water + alcohol extraction for full spectrum</p>
        </div>
        <div style="background:rgba(255,255,255,0.08);border-radius:16px;padding:28px 20px;border:1px solid rgba(255,255,255,0.12);">
          <div style="display:flex;justify-content:center;margin-bottom:12px;">
            <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#52B788" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 3h6l1 4H8L9 3z"/><path d="M8 7v10a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V7"/><path d="M12 11v3M11 13h2"/></svg>
          </div>
          <strong style="color:#fff;display:block;margin-bottom:6px;">Third-Party Tested</strong>
          <p style="color:rgba(255,255,255,0.65);font-size:13px;">Every batch verified for potency and purity</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section style="padding:80px 24px;text-align:center;background:var(--cream);">
    <h2 style="font-size:clamp(28px,4vw,40px);font-weight:900;margin-bottom:16px;">Ready to feel it yourself?</h2>
    <p style="font-size:17px;color:var(--gray);margin-bottom:32px;">Settle. Sharpen. Go. Three flavors, one layered system.</p>
    <a href="/collections/all" class="btn-primary btn-lg">Shop All Flavors →</a>
