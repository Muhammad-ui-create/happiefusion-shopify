{%- comment -%} Single article page — /blogs/<blog>/<article> {%- endcomment -%}
<article class="art">
  <div class="art-head">
    <a href="{{ blog.url }}" class="art-back">← {{ blog.title }}</a>
    <div class="art-meta">{{ article.published_at | date: '%b %d, %Y' }}{% if article.author != blank %} · {{ article.author }}{% endif %}{% if article.tags.size > 0 %} · {{ article.tags.first }}{% endif %}</div>
    <h1 class="art-title">{{ article.title }}</h1>
  </div>

  {%- if article.image -%}
    <div class="art-hero-img">
      <img src="{{ article.image | image_url: width: 1400 }}"
           srcset="{{ article.image | image_url: width: 700 }} 700w, {{ article.image | image_url: width: 1100 }} 1100w, {{ article.image | image_url: width: 1400 }} 1400w"
           sizes="(max-width: 820px) 100vw, 820px"
           alt="{{ article.image.alt | default: article.title }}" width="1400" height="800" loading="eager" fetchpriority="high" />
    </div>
  {%- endif -%}

  <div class="art-body rte">
    {{ article.content }}
  </div>

  <div class="art-footer">
    <a href="{{ blog.url }}" class="btn-ghost">← Back to all posts</a>
    <a href="/collections/all" class="btn-primary">Shop Fungi Fusion →</a>
  </div>
</article>

<style>
.art { max-width: 820px; margin: 0 auto; padding: 40px 24px 80px; }
.art-head { text-align: center; margin-bottom: 28px; }
.art-back { display: inline-block; font-size: 13px; font-weight: 700; color: var(--green, #2D6A4F); text-decoration: none; margin-bottom: 18px; }
.art-meta { font-size: 12.5px; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; color: var(--gray, #6B6B6B); margin-bottom: 12px; }
.art-title { font-size: clamp(30px,5vw,48px); font-weight: 900; letter-spacing: -0.02em; line-height: 1.1; color: #16181B; }
.art-hero-img { border-radius: 22px; overflow: hidden; margin: 8px 0 36px; box-shadow: 0 16px 44px rgba(0,0,0,0.10); }
.art-hero-img img { width: 100%; height: auto; display: block; }

/* Rich-text article body */
.art-body { font-size: 17.5px; line-height: 1.8; color: #2b2f2c; }
.art-body > * + * { margin-top: 22px; }
.art-body h2 { font-size: clamp(24px,3.4vw,32px); font-weight: 900; line-height: 1.2; margin-top: 44px; letter-spacing: -0.01em; color: #16181B; }
.art-body h3 { font-size: 22px; font-weight: 800; margin-top: 34px; color: #16181B; }
.art-body p { margin: 0; }
.art-body a { color: var(--green-dark, #2D6A4F); text-decoration: underline; text-decoration-thickness: 1.5px; text-underline-offset: 3px; }
.art-body ul, .art-body ol { padding-left: 24px; }
.art-body li { margin-bottom: 8px; }
.art-body img { max-width: 100%; height: auto; border-radius: 16px; margin: 12px 0; }
.art-body blockquote { border-left: 4px solid var(--green, #2D6A4F); background: #F6F8F7; margin: 26px 0; padding: 18px 24px; border-radius: 0 12px 12px 0; font-style: italic; color: #333; }
.art-body strong { color: #16181B; }
.art-body table { width: 100%; border-collapse: collapse; font-size: 15px; display: block; overflow-x: auto; }
.art-body th, .art-body td { border: 1px solid rgba(0,0,0,0.1); padding: 10px 14px; text-align: left; }

.art-footer { display: flex; gap: 14px; flex-wrap: wrap; justify-content: center; align-items: center; margin-top: 56px; padding-top: 32px; border-top: 1px solid rgba(0,0,0,0.08); }
@media (max-width: 620px) { .art { padding: 28px 18px 64px; } .art-body { font-size: 16.5px; } }
</style>

{% schema %}
{ "name": "Article", "settings": [] }
{% endschema %}
