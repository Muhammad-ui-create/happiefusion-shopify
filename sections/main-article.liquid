{%- if kr != blank -%}
  <aside class="art-related">
    <span class="art-related-eyebrow">Keep reading</span>
    <ul class="art-related-list">{{ kr }}</ul>
  </aside>
{%- endif -%}

  {%- comment -%} Give every body heading an id (e.g. "3. Blue Raspberry Punch (serves 8)" -> blue-raspberry-punch) so the
      recipes page and other links can deep-link into a post. Ids already written into the post are kept. {%- endcomment -%}
  <script>
  (function(){
    var hs=document.querySelectorAll('.art-body h2, .art-body h3'),used={};
    hs.forEach(function(h){
      if(h.id){used[h.id]=1;return;}
      var t=h.textContent.toLowerCase().replace(/\([^)]*\)/g,'').replace(/^\s*\d+[.)]\s*/,'').replace(/^the\s+/,'')
        .replace(/['’]/g,'').replace(/[^a-z0-9]+/g,'-').replace(/^-+|-+$/g,'');
      if(!t||used[t])return; used[t]=1; h.id=t;
    });
    var id=location.hash&&decodeURIComponent(location.hash.slice(1)),el=id&&document.getElementById(id);
    if(el){
      // keep the target lined up while lazy images above it load; stop as soon as the visitor scrolls
      var stop=false,go=function(){if(!stop)el.scrollIntoView();};
      ['wheel','touchstart','keydown'].forEach(function(e){window.addEventListener(e,function(){stop=true;},{once:true,passive:true});});
      requestAnimationFrame(go);window.addEventListener('load',go);[600,1500,3000].forEach(function(t){setTimeout(go,t);});
    }
  })();
  </script>

  <div class="art-footer">
    <a href="{{ blog.url }}" class="btn-ghost">← Back to all posts</a>
    <a href="/collections/all" class="btn-primary">Shop Fungi Fusion →</a>
  </div>
</article>

{%- comment -%}
  SEO structured data — BlogPosting + BreadcrumbList auto-generated for EVERY article
  from Shopify's own fields. Per-type guards skip any type a post already embeds inline,
  so nothing is ever duplicated. FAQPage is intentionally left to per-post inline schema
  (it needs the visible Q&A text for name parity).
{%- endcomment -%}
{%- assign _seo_desc = article.metafields.global.description_tag.value -%}
{%- if _seo_desc == blank -%}{%- assign _seo_desc = article.excerpt | strip_html -%}{%- endif -%}
{%- if _seo_desc == blank -%}{%- assign _seo_desc = article.content | strip_html | truncate: 200 -%}{%- endif -%}
{%- assign _seo_desc = _seo_desc | strip_newlines | truncate: 300 -%}
{%- assign _art_iso = article.published_at | date: "%Y-%m-%dT%H:%M:%S%z" -%}
{%- capture _art_abs -%}{{ shop.url }}{{ article.url }}{%- endcapture -%}
{%- unless article.content contains 'BlogPosting' -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "@id": {{ _art_abs | append: '#article' | json }},
  "mainEntityOfPage": { "@type": "WebPage", "@id": {{ _art_abs | json }} },
  "url": {{ _art_abs | json }},
  "headline": {{ article.title | json }},
  "description": {{ _seo_desc | json }},
  {%- if article.image %}
  "image": [{{ article.image | image_url: width: 1400 | prepend: 'https:' | json }}],
  {%- endif %}
  "datePublished": {{ _art_iso | json }},
  "dateModified": {{ article.updated_at | default: article.published_at | date: "%Y-%m-%dT%H:%M:%S%z" | json }},
  "author": { "@type": {% if article.author != blank %}"Person", "name": {{ article.author | json }}{% else %}"Organization", "name": "Happie Fungi Fusion"{% endif %} },
  "publisher": {
    "@type": "Organization",
    "name": "Happie Fungi Fusion",
    "logo": { "@type": "ImageObject", "url": {{ 'happie-logo.png' | asset_url | prepend: 'https:' | json }} }
  }
}
</script>
{%- endunless -%}
{%- unless article.content contains 'BreadcrumbList' -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": {{ shop.url | json }} },
    { "@type": "ListItem", "position": 2, "name": {{ blog.title | json }}, "item": {{ shop.url | append: blog.url | json }} },
    { "@type": "ListItem", "position": 3, "name": {{ article.title | json }}, "item": {{ _art_abs | json }} }
  ]
}
</script>
{%- endunless -%}

{%- comment -%} Per-post FAQPage schema (name parity with visible Q&A). Guarded so a post that already embeds FAQPage inline never doubles up. {%- endcomment -%}
{%- unless article.content contains 'FAQPage' -%}
{%- case art_handle -%}
{%- when 'how-long-does-lions-mane-take-to-work' -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How long does it take for lion's mane to work?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "There's no reliable answer for any food or drink. Published human studies of lion's mane have run from a single session to 16 weeks of daily intake, mostly in small groups. That describes how the studies were designed, not a timeline. Study results apply to the specific extracts and amounts that were tested. They don't automatically carry over to any food or drink, ours included."
      }
    },
    {
      "@type": "Question",
      "name": "Does lion's mane work like caffeine?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. Lion's mane is a mushroom, not a stimulant, and it contains no caffeine. Caffeine blocks adenosine and is felt within about 20 to 45 minutes. Lion's mane has no established onset, and nobody can promise an effect or a timeline from a food or drink that contains it."
      }
    },
    {
      "@type": "Question",
      "name": "Does lion's mane contain caffeine?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. Lion's mane is a mushroom and contains no caffeine. The confusion comes from mushroom coffee products, which blend functional mushrooms with actual coffee beans — the caffeine in those products comes entirely from the coffee, typically 45 to 70mg per cup versus roughly 95mg in standard coffee. A mushroom beverage without a coffee base is caffeine-free."
      }
    },
    {
      "@type": "Question",
      "name": "Why do some people say lion's mane did nothing for them?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Lion's mane isn't a stimulant, so anyone expecting it to feel like coffee will be disappointed. The human research is small and early, products differ widely in what they contain, and no one can honestly promise a specific effect or timeline from a food or drink."
      }
    },
    {
      "@type": "Question",
      "name": "Is Fungi Fusion a lion's mane supplement?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. Fungi Fusion is a caffeine-free sparkling drink made with Lion's Mane, Cordyceps and Reishi fruiting body extracts. It's a conventional food, not a supplement, and it isn't a recreation of any study protocol. We don't promise an effect or a timeline from drinking it."
      }
    }
  ]
}
</script>
{%- when 'what-is-ergothioneine' -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is ergothioneine?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Ergothioneine is a naturally occurring amino acid derivative (2-mercaptohistidine trimethylbetaine). It is made only by fungi and certain bacteria, so humans obtain it entirely through diet — most abundantly from mushrooms."
      }
    },
    {
      "@type": "Question",
      "name": "What foods contain the most ergothioneine?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Mushrooms are by far the richest dietary source of ergothioneine, with amounts varying widely by species and concentrated in the fruiting body. Smaller amounts are found in foods such as kidney beans, oat bran, and some other legumes and grains."
      }
    },
    {
      "@type": "Question",
      "name": "Does the human body produce ergothioneine?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. Humans cannot synthesize ergothioneine and must get it from food. Notably, the body has a dedicated transporter protein (OCTN1, encoded by the SLC22A4 gene) that selectively takes up ergothioneine and concentrates it in certain tissues, such as the liver, kidneys, and red blood cells."
      }
    },
    {
      "@type": "Question",
      "name": "Is ergothioneine proven to improve health?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. Most human research on ergothioneine is observational, which shows patterns, not causes. Interventional trials are few and small, and no long-term human outcome trial exists. It's a compound that is being studied, not a proven health ingredient."
      }
    },
    {
      "@type": "Question",
      "name": "Is ergothioneine safe and legal to add to drinks?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "In the United States, fermentation-derived ergothioneine has GRAS status (e.g., FDA Notice GRN 734) and is permitted in certain beverages at a modest per-serving limit. In the European Union it is regulated as a Novel Food requiring prior authorization. Regulatory status varies by region."
      }
    }
  ]
}
</script>
{%- when 'caffeine-free-focus' -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Can you get focus without caffeine?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Focus and stimulation are different things. Caffeine is a stimulant that mutes the feeling of tiredness for a few hours. Caffeine-free drinks, including mushroom drinks, leave the stimulant out, and no caffeine-free drink, ours included, can promise you focus."
      }
    },
    {
      "@type": "Question",
      "name": "Do mushroom drinks give you energy?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Not in the caffeine sense. When a mushroom drink gives you a buzz, caffeine was added to it. Caffeine-free functional mushroom drinks don't contain a stimulant, so they won't give you that kind of jolt."
      }
    },
    {
      "@type": "Question",
      "name": "Is lion's mane a stimulant?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. Lion's mane is a functional mushroom, not a stimulant, and it contains no caffeine."
      }
    },
    {
      "@type": "Question",
      "name": "Will a caffeine-free drink keep me awake at night?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "A truly caffeine-free drink doesn't carry caffeine's late-night cost, which is why it can be an evening option. Always check the label to confirm there's no hidden caffeine source like green tea or guarana."
      }
    }
  ]
}
</script>
{%- when 'functional-mushroom-drinks' -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What are mushroom drinks?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Mushroom drinks are beverages made with extracts of functional mushrooms, usually lion's mane, cordyceps and reishi. They come as ready-to-drink cans, mushroom coffee, teas and powder blends, and small shots. The mushrooms are an ingredient, not a flavor."
      }
    },
    {
      "@type": "Question",
      "name": "Are there ready-to-drink beverages with functional mushrooms?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Ready-to-drink mushroom beverages include sparkling cans, still tonics and bottled teas you drink straight from the fridge. Happie Fungi Fusion, for example, is a caffeine-free sparkling drink with lion's mane, cordyceps and reishi fruiting body extracts in every can."
      }
    },
    {
      "@type": "Question",
      "name": "Do mushroom drinks give you a buzz?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. Lion's mane, cordyceps and reishi are non-intoxicating functional mushrooms. If a mushroom drink feels stimulating, it most likely contains added caffeine."
      }
    },
    {
      "@type": "Question",
      "name": "Do mushroom drinks have caffeine?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Some do and some don't. Mushrooms don't contain caffeine, but many mushroom coffees and mushroom energy drinks add it. Caffeine-free options like Happie Fungi Fusion contain none, so check the label if caffeine matters to you."
      }
    },
    {
      "@type": "Question",
      "name": "Are mushroom drinks safe?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Functional mushrooms are well tolerated by most healthy adults, but quality varies between products. Check the full ingredient list, and talk to your doctor if you're pregnant, nursing, on medication or managing a health condition. This is general information, not medical advice."
      }
    },
    {
      "@type": "Question",
      "name": "How do I know if a mushroom drink is high quality?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Check for caffeine content, the words \"fruiting body\" rather than \"mycelium,\" and an ingredient list that names each mushroom. Vague \"proprietary blend\" labels make it hard to know what you're getting."
      }
    }
  ]
}
</script>
{%- endcase -%}
{%- endunless -%}


<style>
.art { max-width: 820px; margin: 0 auto; padding: 40px 24px 80px; }
.art-head { text-align: center; margin-bottom: 28px; }
.art-back { display: inline-block; font-size: 13px; font-weight: 700; color: var(--green, #2D6A4F); text-decoration: none; margin-bottom: 18px; }
.art-meta { font-size: 12.5px; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; color: var(--gray, #6B6B6B); margin-bottom: 12px; }
.art-title { font-size: clamp(30px,5vw,48px); font-weight: 900; letter-spacing: -0.02em; line-height: 1.1; color: #16181B; }
.art-hero-img { border-radius: 22px; overflow: hidden; margin: 8px 0 36px; box-shadow: 0 16px 44px rgba(0,0,0,0.10); }
.art-hero-img img { width: 100%; height: auto; display: block; }

/* Rich-text article body */
.art-body { font-size: 17.5px; line-height: 1.8; color: #2b2f2c; }
.art-body > * + * { margin-top: 22px; }
.art-body h2 { font-size: clamp(24px,3.4vw,32px); font-weight: 900; line-height: 1.2; margin-top: 44px; letter-spacing: -0.01em; color: #16181B; }
.art-body h3 { font-size: 22px; font-weight: 800; margin-top: 34px; color: #16181B; }
.art-body p { margin: 0; }
.art-body a { color: var(--green-dark, #2D6A4F); text-decoration: underline; text-decoration-thickness: 1.5px; text-underline-offset: 3px; }
.art-body ul, .art-body ol { padding-left: 24px; }
.art-body li { margin-bottom: 8px; }
.art-body img { max-width: 100%; height: auto; border-radius: 16px; margin: 12px 0; }
.art-body blockquote { border-left: 4px solid var(--green, #2D6A4F); background: #F6F8F7; margin: 26px 0; padding: 18px 24px; border-radius: 0 12px 12px 0; font-style: italic; color: #333; }
.art-body strong { color: #16181B; }
.art-body h2, .art-body h3 { scroll-margin-top: calc(var(--nav-h, 96px) + 16px); }
.art-body table { width: 100%; border-collapse: collapse; font-size: 15px; display: block; overflow-x: auto; }
.art-body th, .art-body td { border: 1px solid rgba(0,0,0,0.1); padding: 10px 14px; text-align: left; }

.art-related { margin: 44px 0 0; padding: 22px 24px; background: #F6F8F7; border: 1px solid rgba(0,0,0,0.06); border-radius: 16px; }
.art-related-eyebrow { display: block; font-size: 12px; font-weight: 800; letter-spacing: 0.14em; text-transform: uppercase; color: var(--green, #2D6A4F); margin-bottom: 6px; }
.art-related-list { list-style: none; margin: 0; padding: 0; }
.art-related-list li { margin: 0; padding: 11px 0; border-top: 1px solid rgba(0,0,0,0.07); }
.art-related-list li:first-child { border-top: none; }
.art-related-list a { color: var(--green-dark, #1B4332); font-weight: 700; text-decoration: none; font-size: 16px; }
.art-related-list a:hover { text-decoration: underline; }
.art-footer { display: flex; gap: 14px; flex-wrap: wrap; justify-content: center; align-items: center; margin-top: 56px; padding-top: 32px; border-top: 1px solid rgba(0,0,0,0.08); }
@media (max-width: 620px) { .art { padding: 28px 18px 64px; } .art-body { font-size: 16.5px; } }
</style>

