{%- comment -%}
  Homepage blog marquee: every published article from /blogs/news scrolls in one
  continuous line (right → left), auto-advancing on desktop AND mobile, and still
  swipeable by hand. Cards are captured once then output three times so the loop
  is seamless. THC titles are skipped defensively — this is the NO-THC brand.
{%- endcomment -%}
{%- assign blog = blogs['news'] -%}

<section class="blog-marquee-section">
  <div class="section-inner">
    <div class="section-header">
      <div class="section-eyebrow">The Happie Journal</div>
      <h2 class="section-title">Read up on functional mushrooms</h2>
    </div>
  </div>

  {%- comment -%} Build the card row once into a string, then print it 3× below. {%- endcomment -%}
  {%- capture blog_cards -%}
    {%- for article in blog.articles -%}
      {%- assign t_up = article.title | upcase -%}
      {%- unless t_up contains 'THC' -%}
        <a href="{{ article.url }}" class="bm-card" tabindex="-1">
          <div class="bm-card-img">
            {%- if article.image -%}
              <img src="{{ article.image | image_url: width: 440 }}"
                   srcset="{{ article.image | image_url: width: 440 }} 440w, {{ article.image | image_url: width: 640 }} 640w"
                   sizes="(max-width: 768px) 78vw, 320px"
                   alt="{{ article.image.alt | default: article.title | escape }}"
                   width="440" height="275" loading="lazy" />
            {%- else -%}
              <div class="bm-card-noimg" aria-hidden="true">🍄</div>
            {%- endif -%}
          </div>
          <div class="bm-card-body">
            <div class="bm-card-meta">{{ article.published_at | date: '%b %d, %Y' }}{% if article.tags.size > 0 %} · {{ article.tags.first }}{% endif %}</div>
            <h3 class="bm-card-title">{{ article.title }}</h3>
            <span class="bm-card-link">Read more →</span>
          </div>
        </a>
      {%- endunless -%}
    {%- endfor -%}
  {%- endcapture -%}

  <div class="blog-marquee" id="blog-marquee">
    <div class="blog-marquee-track">
      {{ blog_cards }}{{ blog_cards }}{{ blog_cards }}
    </div>
  </div>

  <div class="section-inner">
    <div class="section-cta-center">
      <a href="/blogs/news" class="btn-primary">Read the journal →</a>
    </div>
  </div>
</section>

<style>
  .blog-marquee-section { padding: 56px 0 60px; background: #fff; overflow: hidden; }
  .blog-marquee-section .section-header { text-align: center; margin-bottom: 30px; }

  /* Full-width auto-scroll marquee (JS-driven, right → left), swipeable */
  .blog-marquee {
    position: relative; width: 100%;
    overflow-x: auto; overflow-y: hidden;
    padding: 8px 0 10px;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    overscroll-behavior-x: contain;
    -webkit-mask: linear-gradient(90deg, transparent 0, #000 4%, #000 96%, transparent 100%);
            mask: linear-gradient(90deg, transparent 0, #000 4%, #000 96%, transparent 100%);
  }
  .blog-marquee::-webkit-scrollbar { display: none; }
  .blog-marquee-track { display: flex; width: max-content; padding: 0 8px; }

  .bm-card {
    flex: 0 0 320px; margin-right: 22px; white-space: normal;
    display: flex; flex-direction: column;
    background: #fff; border: 1px solid rgba(0,0,0,0.08); border-radius: 20px;
    overflow: hidden; text-decoration: none; color: inherit;
    box-shadow: 0 2px 14px rgba(0,0,0,0.05);
    transition: transform 0.18s cubic-bezier(0.16,1,0.3,1), box-shadow 0.18s;
    /* never let a scroll-reveal animation hide marquee cards */
    opacity: 1 !important;
  }
  .bm-card:hover { transform: translateY(-4px); box-shadow: 0 16px 36px rgba(0,0,0,0.12); }
  .bm-card-img { aspect-ratio: 16/10; background: #F3F4F2; overflow: hidden; }
  .bm-card-img img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.3s; }
  .bm-card:hover .bm-card-img img { transform: scale(1.04); }
  .bm-card-noimg { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; font-size: 54px; background: linear-gradient(135deg, #EAF6F0, #F3EEFB); }
  .bm-card-body { padding: 18px 20px 20px; display: flex; flex-direction: column; flex: 1; }
  .bm-card-meta { font-size: 11.5px; font-weight: 700; letter-spacing: 0.03em; text-transform: uppercase; color: var(--green, #2D6A4F); margin-bottom: 9px; }
  .bm-card-title { font-size: 18px; font-weight: 800; line-height: 1.28; margin: 0 0 14px; color: #16181B;
    display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .bm-card-link { font-size: 13.5px; font-weight: 800; color: var(--green-dark, #2D6A4F); margin-top: auto; }

  .blog-marquee-section .section-cta-center { text-align: center; margin-top: 34px; }

  @media (max-width: 768px) {
    .blog-marquee-section { padding: 44px 0 48px; }
    .bm-card { flex: 0 0 78vw; margin-right: 16px; }
    .bm-card-title { font-size: 17px; -webkit-line-clamp: 2; }
  }
</style>

<script>
(function(){
  var scroller = document.getElementById('blog-marquee');
  if(!scroller) return;
  var track = scroller.querySelector('.blog-marquee-track');
  if(!track) return;
  var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var third = 0;
  function measure(){ third = track.scrollWidth / 3; }
  /* forward-only wrap; start at 0 so the first card always renders regardless of JS timing */
  function norm(){
    if(third && scroller.scrollLeft >= 2 * third) scroller.scrollLeft -= third;
  }
  measure();
  window.addEventListener('resize', measure, { passive: true });

  var speed = 0.5, paused = false, resumeTimer;
  function tick(){
    if(!third){ measure(); }
    if(!paused && third){ scroller.scrollLeft += speed; norm(); }
    requestAnimationFrame(tick);
  }
  if(!reduce) requestAnimationFrame(tick);

  function pause(){ paused = true; clearTimeout(resumeTimer); }
  function resume(ms){ clearTimeout(resumeTimer); resumeTimer = setTimeout(function(){ paused = false; }, ms || 0); }
  scroller.addEventListener('mouseenter', pause);
  scroller.addEventListener('mouseleave', function(){ resume(0); });
  scroller.addEventListener('touchstart', pause, { passive: true });
  scroller.addEventListener('touchend', function(){ resume(1800); }, { passive: true });
  scroller.addEventListener('wheel', function(){ pause(); resume(1200); }, { passive: true });
  scroller.addEventListener('scroll', norm, { passive: true });
})();
</script>

{% schema %}
{
  "name": "Blog Marquee",
  "settings": []
}
{% endschema %}
