{%- assign hero_bg = section.settings.hero_bg_color | default: '#6260AE' -%}
<section class="hero hero--split" style="--hero-bg: {{ hero_bg }};">

  <!-- LEFT: solid colour wave panel with the hero copy -->
  <div class="hero-left">
    <div class="hero-left-content">
      <div class="hero-eyebrow">We Put the Fun in Functional</div>
      <h1 class="hero-headline">Calm First.<br>Then Everything Works.</h1>
      <p class="hero-sub">Fungi Fusion is three functional mushrooms working as one system. Reishi settles you, so Lion’s Mane can sharpen your focus and Cordyceps can fuel your day. Sparkling, caffeine-free, and made to feel as good as it tastes.</p>
      <div class="hero-badges">
        <span class="no-alc-badge">Caffeine-Free</span>
        <span class="no-alc-badge">No Crash, No Jitters</span>
        <span class="no-alc-badge">All-Natural</span>
        <span class="no-alc-badge">Vegan &amp; Non-GMO</span>
      </div>
      <div class="hero-ctas">
        <a href="/collections/all" class="btn-primary">Shop Fungi Fusion →</a>
      </div>
      <p class="hero-support">Feel Good. Feel Happie.</p>

      <a href="/pages/reviews" class="hero-reviews-btn" aria-label="Read customer reviews">
        <span class="hero-reviews-stars" aria-hidden="true">★★★★★</span>
        <strong>4.9</strong>
        <span class="hero-reviews-count">· Amazon-verified reviews</span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18l6-6-6-6"/></svg>
      </a>
      <div class="hero-trust">
        <span><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 3h6l1 4H8L9 3z"/><path d="M8 7v10a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V7"/><path d="M12 11v3M11 13h2"/></svg> Third-party lab tested</span>
        <span><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22V12"/><path d="M12 12C12 12 7 10 6 6c3 0 6 2 6 6z"/><path d="M12 12c0 0 5-2 6-6-3 0-6 2-6 6z"/></svg> 100% Fruiting body extract</span>
        <span><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="6" width="15" height="11" rx="2"/><path d="M16 10h4l3 3v4h-7"/><circle cx="5.5" cy="19.5" r="1.5"/><circle cx="20.5" cy="19.5" r="1.5"/></svg> Free shipping, no minimum</span>
      </div>
    </div>

    <!-- Wavy right edge of the panel, flows over the image -->
    <svg class="hero-wave-edge" viewBox="0 0 56 1000" preserveAspectRatio="none" aria-hidden="true">
      <path fill="currentColor" d="M0 0 L34 0 C58 120 10 240 34 360 C58 480 10 600 34 720 C58 840 20 1000 34 1000 L0 1000 Z"/>
    </svg>
  </div>

  <!-- RIGHT: cross-fading lifestyle slideshow -->
  <div class="hero-right">
    <div class="hero-slides">
      {%- for n in (1..5) -%}
        <img
          class="hero-slide{% if forloop.first %} is-active{% endif %}"
          src="{{ 'hero-' | append: n | append: '.jpg' | asset_url }}"
          alt="Happie Fungi Fusion lifestyle"
          width="1200" height="1500"
          {% if forloop.first %}loading="eager" fetchpriority="high"{% else %}loading="lazy"{% endif %}
          decoding="async">
      {%- endfor -%}
    </div>
    <div class="hero-dots" role="tablist" aria-label="Hero slides">
      {%- for n in (1..5) -%}
        <button type="button" class="hero-dot{% if forloop.first %} is-active{% endif %}" aria-label="Show slide {{ n }}"></button>
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
  .hero--split {
    display: grid;
    grid-template-columns: 46% 54%;
    min-height: min(88vh, 800px);
    padding: 0;
    background: var(--hero-bg);
    overflow: hidden;
    position: relative;
  }
  /* LEFT panel */
  .hero--split .hero-left {
    position: relative;
    z-index: 2;
    background: var(--hero-bg);
    display: flex;
    align-items: center;
    padding: 64px clamp(24px, 4.5vw, 72px);
  }
  .hero--split .hero-left-content { max-width: 560px; margin-left: auto; width: 100%; }
  .hero-wave-edge {
    position: absolute; top: 0; bottom: 0; left: 100%;
    height: 100%; width: clamp(26px, 4vw, 56px);
    margin-left: -1px;
    color: var(--hero-bg);
    pointer-events: none;
  }
  /* Copy colours on the solid panel */
  .hero--split .hero-eyebrow { color: rgba(255,255,255,0.78); }
  .hero--split .hero-headline { color: #fff; }
  .hero--split .hero-sub { color: rgba(255,255,255,0.92); }
  .hero--split .hero-support { color: #fff; margin: -8px 0 24px; }
  .hero--split .hero-trust { color: rgba(255,255,255,0.82); }
  .hero--split .no-alc-badge {
    background: rgba(255,255,255,0.15);
    border: 1px solid rgba(255,255,255,0.30);
    color: #fff;
  }
  .hero--split .btn-primary {
    background: #fff; color: var(--hero-bg);
    box-shadow: 0 8px 24px rgba(0,0,0,0.18);
  }
  .hero--split .btn-primary:hover { background: rgba(255,255,255,0.90); transform: translateY(-2px); }

  /* Reviews pill (self-contained, tuned for the dark panel) */
  .hero-reviews-btn {
    display: inline-flex; align-items: center; gap: 8px;
    margin: 0 0 22px;
    background: rgba(255,255,255,0.14);
    border: 1px solid rgba(255,255,255,0.28);
    padding: 9px 16px; border-radius: 50px;
    font-size: 14px; line-height: 1; color: #fff;
    text-decoration: none; cursor: pointer; white-space: nowrap;
    transition: background .2s, transform .15s;
  }
  .hero-reviews-btn:hover { background: rgba(255,255,255,0.24); transform: translateY(-1px); }
  .hero-reviews-stars { color: #FFCB05; letter-spacing: 1px; }
  .hero-reviews-btn strong { font-weight: 800; }
  .hero-reviews-count { color: rgba(255,255,255,0.72); }

  /* RIGHT slideshow */
  .hero-right {
    position: relative; overflow: hidden;
    background: var(--hero-bg);
    min-height: min(88vh, 800px);
  }
  .hero-slides { position: absolute; inset: 0; }
  .hero-slide {
    position: absolute; inset: 0;
    object-fit: cover;
    opacity: 0; transition: opacity 1.1s ease;
    will-change: opacity;
  }
  .hero-slide.is-active { opacity: 1; }
  .hero-dots {
    position: absolute; z-index: 3;
    bottom: 20px; left: 0; right: 0;
    display: flex; justify-content: center; gap: 9px;
  }
  .hero-dot {
    width: 9px; height: 9px; border-radius: 50%;
    border: none; background: rgba(255,255,255,0.5);
    cursor: pointer; padding: 0; transition: background .2s, transform .2s;
  }
  .hero-dot.is-active { background: #fff; transform: scale(1.25); }

  @media (prefers-reduced-motion: reduce) {
    .hero-slide { transition: none; }
  }

  @media (max-width: 900px) {
    .hero--split { grid-template-columns: 1fr; min-height: auto; }
    .hero--split .hero-right { order: -1; height: 56vh; min-height: 360px; }
    .hero--split .hero-left { padding: 40px 22px 48px; text-align: center; }
    .hero--split .hero-left-content { margin: 0 auto; }
    .hero-wave-edge { display: none; }
    .hero--split .hero-badges,
    .hero--split .hero-ctas,
    .hero--split .hero-trust { justify-content: center; }
    .hero-reviews-btn { align-self: center; }
  }
</style>

<script>
  (function () {
    var section = document.querySelector('.hero--split');
    if (!section) return;
    var slides = section.querySelectorAll('.hero-slide');
    var dots = section.querySelectorAll('.hero-dot');
    if (slides.length < 2) return;
    var i = 0, timer;
    var INTERVAL = {{ section.settings.slide_seconds | default: 5 | times: 1000 }};
    function show(n) {
      slides[i].classList.remove('is-active');
      if (dots[i]) dots[i].classList.remove('is-active');
      i = (n + slides.length) % slides.length;
      slides[i].classList.add('is-active');
      if (dots[i]) dots[i].classList.add('is-active');
    }
    function start() { timer = setInterval(function () { show(i + 1); }, INTERVAL); }
    dots.forEach(function (d, idx) {
      d.addEventListener('click', function () { clearInterval(timer); show(idx); start(); });
    });
    start();
  })();
</script>

{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "color",
      "id": "hero_bg_color",
      "label": "Text panel background colour",
      "default": "#6260AE"
    },
    {
      "type": "range",
      "id": "slide_seconds",
      "label": "Seconds per slide",
      "min": 3, "max": 10, "step": 1, "unit": "s",
      "default": 5
    }
  ]
}
{% endschema %}
