<section class="featured-collection">
  <div class="section-inner">
    <div class="section-header">
      <div class="section-eyebrow">The Flavors</div>
      <h2 class="section-title">Three flavors. Same arc.</h2>
    </div>

    {%- comment -%} Editorial block: flavor list on the left, one hero shot of the trio on the right {%- endcomment -%}
    <div class="flavors-split">
      <div class="flavors-list">
        <a class="flavor-row" href="/products/watermelon-fungi-powered-seltzer">
          <span class="flavor-row-head">
            <span class="flavor-row-name">Watermelon</span>
            <span class="flavor-tag flavor-tag--wm">The crisp one</span>
          </span>
          <span class="flavor-row-desc">Ocean minerals and watermelon do most of the work.</span>
        </a>
        <a class="flavor-row" href="/products/mango-mimosa-fungi-powered-seltzer">
          <span class="flavor-row-head">
            <span class="flavor-row-name">Mango</span>
            <span class="flavor-tag flavor-tag--mg">The warm one</span>
          </span>
          <span class="flavor-row-desc">Ripe and full, for afternoons that need a turn rather than a jolt.</span>
        </a>
        <a class="flavor-row" href="/products/blue-razzberry-fungi-powered-seltzer">
          <span class="flavor-row-head">
            <span class="flavor-row-name">Blue Raspberry</span>
            <span class="flavor-tag flavor-tag--br">The bold one</span>
          </span>
          <span class="flavor-row-desc">The most fun can in the fridge, and it still does the job.</span>
        </a>
      </div>
      <div class="flavors-hero">
        <img src="https://cdn.shopify.com/s/files/1/0725/4946/6177/files/flavors-trio-hero-2.jpg?v=1789391351"
             alt="Happie Fungi Fusion &mdash; Watermelon, Mango Mimosa and Blue Raspberry cans with fresh fruit"
             width="1200" height="1490" loading="lazy">
      </div>
    </div>

    {%- comment -%} Divider separates the editorial block above from the shoppable grid below {%- endcomment -%}
    <div class="flavor-shop-divider">
      <span class="flavor-shop-divider-line" aria-hidden="true"></span>
      <span class="flavor-shop-divider-label">Shop the lineup</span>
      <span class="flavor-shop-divider-line" aria-hidden="true"></span>
    </div>

    <style>
      /* ── Editorial split: flavor list + hero ── */
      .flavors-split {
        display: grid; grid-template-columns: 1fr 0.9fr; gap: clamp(28px, 5vw, 60px);
        align-items: center; max-width: 1080px; margin: 8px auto 40px;
      }
      .flavors-list { display: flex; flex-direction: column; gap: 10px; }
      .flavor-row {
        display: block; text-decoration: none; color: inherit;
        padding: 20px 24px; border-radius: 18px; background: #fff;
        border: 1px solid rgba(0,0,0,0.06); box-shadow: 0 3px 14px rgba(27,67,50,0.05);
        transition: transform 0.18s ease, box-shadow 0.24s ease, border-color 0.2s ease;
      }
      .flavor-row:hover { transform: translateX(5px); box-shadow: 0 14px 32px rgba(27,67,50,0.13); border-color: rgba(45,106,79,0.18); }
      .flavor-row-head { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }
      .flavor-row-name { font-size: clamp(22px, 2.6vw, 26px); font-weight: 900; letter-spacing: -0.02em; color: var(--ink, #16181B); line-height: 1.05; }
      .flavor-tag {
        display: inline-block; padding: 4px 12px; border-radius: 50px;
        font-size: 11px; font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase;
      }
      .flavor-tag--wm { background: #FDE5E9; color: #C13C5B; }
      .flavor-tag--mg { background: #FDEFD3; color: #B57314; }
      .flavor-tag--br { background: #E6E4FA; color: #5B4BC4; }
      .flavor-row-desc { display: block; margin-top: 10px; font-size: 15.5px; line-height: 1.6; color: var(--gray, #55605A); }

      .flavors-hero {
        border-radius: 24px; overflow: hidden;
        background: linear-gradient(180deg, #F4F7FA 0%, #E9EEF3 100%);
        box-shadow: 0 22px 54px rgba(27,67,50,0.13);
      }
      .flavors-hero img { display: block; width: 100%; height: auto; }

      /* ── Shop divider ── */
      .flavor-shop-divider {
        display: flex; align-items: center; gap: 22px;
        max-width: 680px; margin: 14px auto 44px;
      }
      .flavor-shop-divider-line {
        flex: 1; height: 2px;
        background: linear-gradient(90deg, transparent, rgba(45,106,79,0.32), transparent);
      }
      .flavor-shop-divider-label {
        flex-shrink: 0; font-size: 17px; font-weight: 900; letter-spacing: 0.14em;
        text-transform: uppercase; color: var(--green, #2D6A4F);
      }

      @media (max-width: 860px) {
        .flavors-split { grid-template-columns: 1fr; gap: 24px; margin-bottom: 30px; }
        .flavors-hero { order: -1; max-width: 440px; margin: 0 auto; }
        .flavor-shop-divider { gap: 16px; margin: 10px auto 32px; }
        .flavor-shop-divider-label { font-size: 15px; }
      }
    </style>

    <div class="products-grid">
      {% assign priority_handles = 'blue-razzberry-fungi-powered-seltzer,mango-mimosa-fungi-powered-seltzer,watermelon-fungi-powered-seltzer' | split: ',' %}
      {% assign shown = '' %}
      {% comment %} Sold-out products are skipped so the grid stays one clean row {% endcomment %}
      {% for handle in priority_handles %}
        {% assign product = all_products[handle] %}
        {% if product.id != blank and product.available %}
          {% render 'product-card', product: product %}
          {% assign shown = shown | append: handle | append: ',' %}
        {% endif %}
      {% endfor %}
      {% comment %} Only drinks belong on the homepage, merch (any non-Beverage type) is excluded {% endcomment %}
      {% for product in collections['all'].products %}
        {% unless shown contains product.handle %}
          {% if product.available and product.type == 'Beverage' and product.handle != 'fungi-fusion-auto-refill' %}
            {% render 'product-card', product: product %}
          {% endif %}
        {% endunless %}
      {% endfor %}
    </div>
    <div class="section-cta-center">
      <a href="/collections/all" class="btn-primary">Find Your Flavor →</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured Collection",
  "settings": []
}
{% endschema %}
