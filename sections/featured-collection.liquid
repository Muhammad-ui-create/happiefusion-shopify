<section class="featured-collection">
  <div class="section-inner">
    <div class="section-header">
      <div class="section-eyebrow">The Flavors</div>
      <h2 class="section-title">Three flavors. Same arc.</h2>
    </div>
    <ul class="flavor-descriptors">
      <li class="flavor-card">
        <a href="/products/watermelon-fungi-powered-seltzer">
          <span class="flavor-card-media">
            <img src="https://cdn.shopify.com/s/files/1/0725/4946/6177/files/flavor-bed-watermelon.jpg?v=1788798786" alt="Watermelon Fungi Fusion can nestled in fresh watermelon" width="300" height="375" loading="lazy">
          </span>
          <span class="flavor-card-body">
            <span class="flavor-card-name">Watermelon</span>
            <span class="flavor-card-tag flavor-card-tag--wm">The crisp one</span>
            <span class="flavor-card-desc">Ocean minerals and watermelon do most of the work.</span>
          </span>
        </a>
      </li>
      <li class="flavor-card">
        <a href="/products/mango-mimosa-fungi-powered-seltzer">
          <span class="flavor-card-media">
            <img src="https://cdn.shopify.com/s/files/1/0725/4946/6177/files/flavor-bed-mango.jpg?v=1788798786" alt="Mango Mimosa Fungi Fusion can nestled in fresh mango" width="300" height="375" loading="lazy">
          </span>
          <span class="flavor-card-body">
            <span class="flavor-card-name">Mango</span>
            <span class="flavor-card-tag flavor-card-tag--mg">The warm one</span>
            <span class="flavor-card-desc">Ripe and full, for afternoons that need a turn rather than a jolt.</span>
          </span>
        </a>
      </li>
      <li class="flavor-card">
        <a href="/products/blue-razzberry-fungi-powered-seltzer">
          <span class="flavor-card-media">
            <img src="https://cdn.shopify.com/s/files/1/0725/4946/6177/files/flavor-bed-blueraspberry.jpg?v=1788798786" alt="Blue Raspberry Fungi Fusion can nestled in fresh blueberries" width="300" height="375" loading="lazy">
          </span>
          <span class="flavor-card-body">
            <span class="flavor-card-name">Blue Raspberry</span>
            <span class="flavor-card-tag flavor-card-tag--br">The bold one</span>
            <span class="flavor-card-desc">The most fun can in the fridge, and it still does the job.</span>
          </span>
        </a>
      </li>
    </ul>

    {%- comment -%} Divider separates the editorial flavor cards above from the shoppable grid below {%- endcomment -%}
    <div class="flavor-shop-divider">
      <span class="flavor-shop-divider-line" aria-hidden="true"></span>
      <span class="flavor-shop-divider-label">Shop the lineup</span>
      <span class="flavor-shop-divider-line" aria-hidden="true"></span>
    </div>

    <style>
      .flavor-descriptors {
        list-style: none; margin: 0 auto 34px; padding: 0; max-width: 1000px;
        display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px;
      }
      .flavor-shop-divider {
        display: flex; align-items: center; gap: 22px;
        max-width: 680px; margin: 14px auto 44px;
      }
      .flavor-shop-divider-line {
        flex: 1; height: 2px;
        background: linear-gradient(90deg, transparent, rgba(45,106,79,0.32), transparent);
      }
      .flavor-shop-divider-label {
        flex-shrink: 0; font-size: 17px; font-weight: 900; letter-spacing: 0.14em;
        text-transform: uppercase; color: var(--green, #2D6A4F);
      }
      .flavor-card {
        background: #fff; border: 1px solid rgba(0,0,0,0.06); border-radius: 20px;
        box-shadow: 0 4px 16px rgba(27,67,50,0.06); overflow: hidden;
        transition: transform 0.18s ease, box-shadow 0.24s ease;
      }
      .flavor-card:hover { transform: translateY(-4px); box-shadow: 0 16px 36px rgba(27,67,50,0.14); }
      .flavor-card a { display: block; text-decoration: none; color: inherit; }
      .flavor-card-media { display: block; overflow: hidden; }
      .flavor-card-media img {
        display: block; width: 100%; aspect-ratio: 4 / 5; height: auto;
        object-fit: cover; transition: transform 0.5s ease;
      }
      .flavor-card:hover .flavor-card-media img { transform: scale(1.05); }
      .flavor-card-body { display: block; padding: 20px 22px 24px; }
      .flavor-card-name {
        display: block; font-size: 21px; font-weight: 900; letter-spacing: -0.015em;
        color: var(--ink, #16181B); line-height: 1.1;
      }
      .flavor-card-tag {
        display: inline-block; margin-top: 10px; padding: 4px 12px; border-radius: 50px;
        font-size: 11.5px; font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase;
      }
      .flavor-card-tag--wm { background: #FDE5E9; color: #C13C5B; }
      .flavor-card-tag--mg { background: #FDEFD3; color: #B57314; }
      .flavor-card-tag--br { background: #E6E4FA; color: #5B4BC4; }
      .flavor-card-desc {
        display: block; margin-top: 12px; font-size: 15px; line-height: 1.6;
        color: var(--gray, #55605A);
      }
      @media (max-width: 820px) {
        .flavor-descriptors { grid-template-columns: 1fr; gap: 14px; margin-bottom: 26px; }
        .flavor-shop-divider { gap: 16px; margin: 10px auto 32px; }
        .flavor-shop-divider-label { font-size: 15px; }
      }
    </style>
    <div class="products-grid">
      {% assign priority_handles = 'blue-razzberry-fungi-powered-seltzer,mango-mimosa-fungi-powered-seltzer,watermelon-fungi-powered-seltzer' | split: ',' %}
      {% assign shown = '' %}
      {% comment %} Sold-out products are skipped so the grid stays one clean row {% endcomment %}
      {% for handle in priority_handles %}
        {% assign product = all_products[handle] %}
        {% if product.id != blank and product.available %}
          {% render 'product-card', product: product %}
          {% assign shown = shown | append: handle | append: ',' %}
        {% endif %}
      {% endfor %}
      {% comment %} Only drinks belong on the homepage, merch (any non-Beverage type) is excluded {% endcomment %}
      {% for product in collections['all'].products %}
        {% unless shown contains product.handle %}
          {% if product.available and product.type == 'Beverage' and product.handle != 'fungi-fusion-auto-refill' %}
            {% render 'product-card', product: product %}
          {% endif %}
        {% endunless %}
      {% endfor %}
    </div>
    <div class="section-cta-center">
      <a href="/collections/all" class="btn-primary">Find Your Flavor →</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured Collection",
  "settings": []
}
{% endschema %}
