<section class="featured-collection">
  <div class="section-inner">
    <div class="section-header">
      <div class="section-eyebrow">The Flavors</div>
      <h2 class="section-title">Wellness That Tastes Like a Treat</h2>
      <p class="section-sub">Bright, real-fruit flavor with a clean sparkling finish. Pick your ritual. Each flavor is built around its lead mushroom, and they’re made to work together. Mix a case. Drink the system.</p>
    </div>
    <div class="products-grid">
      {% assign priority_handles = 'blue-razzberry-fungi-powered-seltzer,mango-mimosa-fungi-powered-seltzer,watermelon-fungi-powered-seltzer' | split: ',' %}
      {% assign shown = '' %}
      {% comment %} Sold-out products are skipped so the grid stays one clean row {% endcomment %}
      {% for handle in priority_handles %}
        {% assign product = all_products[handle] %}
        {% if product.id != blank and product.available %}
          {% render 'product-card', product: product %}
          {% assign shown = shown | append: handle | append: ',' %}
        {% endif %}
      {% endfor %}
      {% comment %} Only drinks belong on the homepage, merch (any non-Beverage type) is excluded {% endcomment %}
      {% for product in collections['all'].products %}
        {% unless shown contains product.handle %}
          {% if product.available and product.type == 'Beverage' and product.handle != 'fungi-fusion-auto-refill' %}
            {% render 'product-card', product: product %}
          {% endif %}
        {% endunless %}
      {% endfor %}
    </div>
    <div class="section-cta-center">
      <a href="/collections/all" class="btn-primary">Find Your Flavor →</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured Collection",
  "settings": []
}
{% endschema %}
