<section class="home-founder">
  <div class="home-founder-inner">
    <span class="home-founder-eyebrow">From the founder</span>
    <h2 class="home-founder-title">Why we made it</h2>
    <div class="home-founder-frame">
      <video
        class="home-founder-video"
        controls
        playsinline
        preload="metadata"
        poster="https://cdn.shopify.com/s/files/1/0725/4946/6177/files/pete-founder-poster.jpg?v=1788777299"
        width="360" height="640">
        <source src="https://cdn.shopify.com/s/files/1/0725/4946/6177/files/pete-founder.mp4?v=1788777299" type="video/mp4">
        Your browser doesn&rsquo;t support embedded video.
      </video>
    </div>
    <p class="home-founder-cap">Pete Olander &middot; Founder, Happie Fungi Fusion</p>
  </div>
</section>

<style>
  .home-founder { background: #FFFFFF; padding: clamp(48px, 7vw, 84px) 22px; }
  .home-founder-inner { max-width: 720px; margin: 0 auto; text-align: center; }
  .home-founder-eyebrow {
    display: inline-block; font-size: 12px; font-weight: 800; letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--green, #2D6A4F); margin-bottom: 12px;
  }
  .home-founder-title { font-size: clamp(24px, 3.6vw, 36px); font-weight: 900; letter-spacing: -0.02em; color: var(--ink, #16181B); margin: 0 0 28px; }
  .home-founder-frame {
    position: relative; width: 100%; max-width: 340px; margin: 0 auto;
    aspect-ratio: 9 / 16; border-radius: 22px; overflow: hidden;
    background: #1B4332; box-shadow: 0 18px 48px rgba(27,67,50,0.24);
  }
  .home-founder-video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; background: #1B4332; }
  .home-founder-cap { margin: 18px 0 0; font-size: 13.5px; font-weight: 700; color: var(--green, #2D6A4F); }
</style>

{% schema %}
{
  "name": "Home — Founder Video",
  "settings": []
}
{% endschema %}
